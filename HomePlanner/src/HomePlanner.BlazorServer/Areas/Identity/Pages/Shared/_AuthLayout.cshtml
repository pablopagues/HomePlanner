<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HomePlanner</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@300;400;500;600&display=swap" />
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: #FAF7F2;
            color: #2A3A33;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .auth-card {
            background: #FFFFFF;
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(42,58,51,0.08);
            padding: 40px;
            width: 100%;
            max-width: 420px;
        }
        .auth-logo {
            font-family: 'Fraunces', serif;
            font-weight: 300;
            font-size: 28px;
            color: #4A6B5C;
            text-align: center;
            margin: 0 0 4px;
        }
        .auth-sub {
            text-align: center;
            color: #7A8278;
            font-size: 13px;
            margin: 0 0 28px;
        }
        .auth-title {
            font-family: 'Fraunces', serif;
            font-weight: 400;
            font-size: 20px;
            color: #2A3A33;
            margin: 0 0 20px;
        }
        label { display:block; font-size: 13px; font-weight: 500; margin-bottom: 6px; color:#2A3A33; }
        .form-group { margin-bottom: 16px; }
        input[type=text], input[type=email], input[type=password], select {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid #E8DDD1;
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            background: #FDFAF7;
            transition: border-color 200ms;
        }
        input:focus, select:focus { outline: none; border-color: #4A6B5C; }
        .btn-primary {
            width: 100%;
            background: #C97B5A;
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            padding: 13px;
            font-size: 15px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            transition: background 200ms;
        }
        .btn-primary:hover { background: #b56a4b; }
        .checkbox-row { display:flex; align-items:flex-start; gap:8px; margin-bottom:16px; font-size:13px; color:#7A8278; }
        .checkbox-row input { margin-top:2px; }
        .auth-links { text-align:center; margin-top:20px; font-size:13px; }
        .auth-links a { color:#4A6B5C; text-decoration:none; }
        .auth-links a:hover { text-decoration:underline; }
        .validation-summary, .field-validation-error, .text-danger {
            color: #B05050; font-size: 13px;
        }
        .alert-success { background:#EEF5F1; border:1px solid #B5CFC0; color:#3A5A48; padding:12px 16px; border-radius:8px; font-size:14px; margin-bottom:16px; }
        .alert-error { background:#FBEDED; border:1px solid #E5BcBc; color:#9A4444; padding:12px 16px; border-radius:8px; font-size:14px; margin-bottom:16px; }
    </style>
</head>
<body>
    <div class="auth-card">
        <p class="auth-logo">HomePlanner</p>
        <p class="auth-sub">by Sideris</p>
        @RenderBody()
    </div>
</body>
</html>
