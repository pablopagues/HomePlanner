@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.ConfirmarEmailModel
@{
    ViewData["Title"] = L["Conta_ConfirmarEmail"];
}

<h1 class="auth-title">@L["Conta_ConfirmacaoEmail"]</h1>

@if (Model.Sucesso)
{
    <div class="alert-success">@Model.Mensagem</div>
    <div class="auth-links"><a asp-page="./Login">@L["Conta_EntrarAgora"]</a></div>
}
else
{
    <div class="alert-error">@Model.Mensagem</div>
    <div class="auth-links"><a asp-page="./Login">@L["Auth_VoltarLogin"]</a></div>
}
