@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.RedefinirSenhaModel
@{
    var ehConvite = Model.Input.Convite;
    ViewData["Title"] = ehConvite ? "Criar senha" : "Nova senha";
}

<h1 class="auth-title">@(ehConvite ? "Bem-vindo(a) ao HomePlanner" : "Criar nova senha")</h1>

@if (Model.Concluido)
{
    <div class="alert-success">
        @(ehConvite ? "Senha criada com sucesso! Já pode entrar." : "Senha redefinida com sucesso!")
    </div>
    <div class="auth-links"><a asp-page="./Login">Entrar</a></div>
}
else
{
    @if (ehConvite)
    {
        <p style="font-size:14px; color:#7A8278;">
            Defina a senha que você vai usar para entrar na conta da sua família.
        </p>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input asp-for="Input.UserId" type="hidden" />
        <input asp-for="Input.Token" type="hidden" />
        <input asp-for="Input.Convite" type="hidden" />

        <div class="form-group">
            <label asp-for="Input.Senha">@(ehConvite ? "Sua senha" : "Nova senha")</label>
            <input asp-for="Input.Senha" autocomplete="new-password" />
            <span asp-validation-for="Input.Senha" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.ConfirmacaoSenha">Confirmar senha</label>
            <input asp-for="Input.ConfirmacaoSenha" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmacaoSenha" class="text-danger"></span>
        </div>
        <button type="submit" class="btn-primary">@(ehConvite ? "Criar senha e entrar" : "Redefinir senha")</button>
    </form>
}
