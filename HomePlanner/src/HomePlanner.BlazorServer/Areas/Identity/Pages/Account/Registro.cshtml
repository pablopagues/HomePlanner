@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.RegistroModel
@{
    ViewData["Title"] = "Criar conta";
}

<h1 class="auth-title">Criar sua conta</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="Input.NomeResponsavel">Seu nome</label>
        <input asp-for="Input.NomeResponsavel" autocomplete="name" />
        <span asp-validation-for="Input.NomeResponsavel" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Email">E-mail</label>
        <input asp-for="Input.Email" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.PaisId">País</label>
        <select asp-for="Input.PaisId">
            <option value="BR">Brasil</option>
            <option value="CA">Canadá</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Input.Senha">Senha</label>
        <input asp-for="Input.Senha" autocomplete="new-password" />
        <span asp-validation-for="Input.Senha" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.ConfirmacaoSenha">Confirmar senha</label>
        <input asp-for="Input.ConfirmacaoSenha" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmacaoSenha" class="text-danger"></span>
    </div>

    <div class="checkbox-row">
        <input asp-for="Input.AceitaTermos" />
        <label asp-for="Input.AceitaTermos" style="font-weight:400; margin:0;">
            Li e aceito os termos de uso e a política de privacidade.
        </label>
    </div>
    <span asp-validation-for="Input.AceitaTermos" class="text-danger"></span>

    <button type="submit" class="btn-primary">Criar conta grátis</button>
</form>

<div class="auth-links">
    Já tem conta? <a asp-page="./Login">Entrar</a>
</div>
