@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.LoginCom2FAModel
@{
    ViewData["Title"] = L["Auth_2FATitulo"];
}

<h1 class="auth-title">@L["Auth_2FATitulo"]</h1>

<p class="auth-sub" style="margin-bottom:20px;">
    @L["Conta_2FAAbraApp"]
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="RememberMe" />

    <div class="form-group">
        <label asp-for="Codigo">@L["Conta_2FACodigoAutenticador"]</label>
        <input asp-for="Codigo"
               type="text"
               inputmode="numeric"
               autocomplete="one-time-code"
               autofocus
               maxlength="7"
               placeholder="000000"
               style="letter-spacing:4px; font-size:1.2em; text-align:center;" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>

    <div class="checkbox-row">
        <input asp-for="LembrarDispositivo" />
        <label asp-for="LembrarDispositivo" style="font-weight:400; margin:0;">
            @L["Conta_2FALembrar"]
        </label>
    </div>

    <button type="submit" class="btn-primary">@L["Conta_Verificar"]</button>
</form>

<div class="auth-links">
    <a asp-page="./LoginComCodigoRecuperacao"
       asp-route-returnUrl="@Model.ReturnUrl"
       asp-route-rememberMe="@Model.RememberMe">@L["Auth_2FAUsarRec"]</a>
    <br /><br />
    <a asp-page="./Login">@L["Auth_VoltarLogin"]</a>
</div>
