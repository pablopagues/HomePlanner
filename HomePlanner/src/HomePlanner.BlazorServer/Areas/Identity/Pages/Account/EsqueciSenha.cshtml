@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.EsqueciSenhaModel
@{
    ViewData["Title"] = L["Auth_EsqueciSenha"];
}

<h1 class="auth-title">@L["Conta_RedefinirSenha"]</h1>

@if (Model.Enviado)
{
    <div class="alert-success">
        @L["Auth_EsqueciEnviado"]
    </div>
    <div class="auth-links"><a asp-page="./Login">@L["Auth_VoltarLogin"]</a></div>
}
else
{
    <p style="font-size:14px; color:#7A8278;">
        @L["Auth_EsqueciSub"]
    </p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-group">
            <label asp-for="Input.Email">@L["Auth_Email"]</label>
            <input asp-for="Input.Email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn-primary">@L["Auth_EnviarLink"]</button>
    </form>
    <div class="auth-links"><a asp-page="./Login">@L["Auth_VoltarLogin"]</a></div>
}
