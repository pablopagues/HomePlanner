@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.LoginComCodigoRecuperacaoModel
@{
    ViewData["Title"] = "Código de recuperação";
}

<h1 class="auth-title">Código de recuperação</h1>

<p class="auth-sub" style="margin-bottom:20px;">
    Informe um dos códigos de recuperação que você salvou ao ativar a verificação em duas etapas.
    Cada código só pode ser usado uma vez.
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="form-group">
        <label asp-for="CodigoRecuperacao">Código de recuperação</label>
        <input asp-for="CodigoRecuperacao"
               type="text"
               autocomplete="off"
               autofocus
               placeholder="xxxxx-xxxxx"
               style="letter-spacing:2px; text-align:center;" />
        <span asp-validation-for="CodigoRecuperacao" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-primary">Verificar</button>
</form>

<div class="auth-links">
    <a asp-page="./LoginCom2FA" asp-route-returnUrl="@Model.ReturnUrl">Usar o app autenticador</a>
    <br /><br />
    <a asp-page="./Login">Voltar ao login</a>
</div>
