@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.LoginComCodigoRecuperacaoModel
@{
    ViewData["Title"] = L["Conta_CodigoRecuperacao"];
}

<h1 class="auth-title">@L["Conta_CodigoRecuperacao"]</h1>

<p class="auth-sub" style="margin-bottom:20px;">
    @L["Conta_RecuperacaoAjuda"]
    
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="form-group">
        <label asp-for="CodigoRecuperacao">@L["Conta_CodigoRecuperacao"]</label>
        <input asp-for="CodigoRecuperacao"
               type="text"
               autocomplete="off"
               autofocus
               placeholder="xxxxx-xxxxx"
               style="letter-spacing:2px; text-align:center;" />
        <span asp-validation-for="CodigoRecuperacao" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-primary">@L["Conta_Verificar"]</button>
</form>

<div class="auth-links">
    <a asp-page="./LoginCom2FA" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_2FAUsarApp"]</a>
    <br /><br />
    <a asp-page="./Login">@L["Auth_VoltarLogin"]</a>
</div>
