@page
@model HomePlanner.BlazorServer.Areas.Identity.Pages.Account.VerificarEmailModel
@{
    ViewData["Title"] = L["Conta_VerifiqueEmail"];
}

<h1 class="auth-title">@L["Conta_QuaseLa"]</h1>

<div class="alert-success">
    @L["Conta_EnviamosConfirmacao"] <strong>@Model.Email</strong>.
    @L["Conta_CliqueLink"]
</div>

<p style="font-size:13px; color:#7A8278;">
    @L["Conta_NaoRecebeu"]
    <a asp-page="./Registro" style="color:#4A6B5C;">@L["Conta_TenteNovamente"]</a>.
</p>

<div class="auth-links">
    <a asp-page="./Login">@L["Auth_IrLogin"]</a>
</div>
