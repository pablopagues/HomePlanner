<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,400&family=Inter:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
    <link rel="stylesheet" href="css/app.css?v=2" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FBF8F2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <div id="components-reconnect-modal" class="hp-reconnect-modal">
        <div class="hp-reconnect-card">
            <div class="hp-reconnect-spinner" aria-hidden="true"></div>

            <div class="hp-reconnect-text hp-reconnect-text--show">
                <h2>Reconectando…</h2>
                <p>A conexão caiu. Tentando restabelecer automaticamente.</p>
            </div>

            <div class="hp-reconnect-text hp-reconnect-text--failed">
                <h2>Sem conexão</h2>
                <p>Não foi possível reconectar automaticamente.</p>
            </div>

            <div class="hp-reconnect-text hp-reconnect-text--rejected">
                <h2>Sessão expirada</h2>
                <p>Precisamos recarregar a página para continuar.</p>
            </div>

            <div class="hp-reconnect-actions">
                <button type="button" class="hp-reconnect-btn hp-reconnect-btn--retry"
                        onclick="window.Blazor.reconnect()">
                    Tentar novamente
                </button>
                <button type="button" class="hp-reconnect-btn hp-reconnect-btn--reload"
                        onclick="location.reload()">
                    Recarregar página
                </button>
            </div>
        </div>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/app.js"></script>
    <script src="js/push.js"></script>
</body>

</html>
