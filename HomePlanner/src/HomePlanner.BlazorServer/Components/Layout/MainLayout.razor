@inherits LayoutComponentBase
@using HomePlanner.BlazorServer.Theme
@using HomePlanner.BlazorServer.Services
@using HomePlanner.BlazorServer.Components.Shared
@inject IStringLocalizer<SharedResource> L
@inject PublicLanguageService Lang
@inject PersistentComponentState PersistentState
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider Theme="_temaAtivo" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3"
                 Style="font-family: 'Fraunces', serif; font-weight: 400; color:var(--mud-palette-primary);">
            HomePlanner
        </MudText>
        <MudSpacer />
        <LanguageToggle />
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2">
            <MudMenuItem Href="@Lang.U("/perfil")" Icon="@Icons.Material.Filled.ManageAccounts">
                @L["Nav_Perfil"]
            </MudMenuItem>

            <MudDivider Class="my-1" />
            <MudListSubheader>
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" />
                    <MudText Typo="Typo.caption">@L["Nav_Tema"]</MudText>
                </MudStack>
            </MudListSubheader>
            <MudMenuItem OnClick="@(() => AplicarTema("sage"))">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <div style="width:14px;height:14px;border-radius:50%;background:#4A6B5C;flex:none;"></div>
                    <span>Sage &amp; Terracotta</span>
                    @if (_temaNome == "sage") { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" /> }
                </MudStack>
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => AplicarTema("plum"))">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <div style="width:14px;height:14px;border-radius:50%;background:#7a4a9a;flex:none;"></div>
                    <span>Plum &amp; Blush</span>
                    @if (_temaNome == "plum") { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" /> }
                </MudStack>
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => AplicarTema("carbon"))">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <div style="width:14px;height:14px;border-radius:50%;background:#4dc9a0;flex:none;"></div>
                    <span>Carbon &amp; Mint</span>
                    @if (_temaNome == "carbon") { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" /> }
                </MudStack>
            </MudMenuItem>
            <MudDivider Class="my-1" />

            <MudMenuItem Href="/Identity/Account/Logout" ForceLoad="true" Icon="@Icons.Material.Filled.Logout">
                @L["Nav_Sair"]
            </MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerAberto" ClipMode="DrawerClipMode.Always"
               Elevation="2" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Dashboard">
                @L["Nav_Dashboard"]
            </MudNavLink>
            <MudNavLink Href="@Lang.U("/cardapio")"
                        Icon="@Icons.Material.Filled.CalendarMonth">
                @L["Nav_Cardapio"]
            </MudNavLink>
            <MudNavLink Href="@Lang.U("/receitas")"
                        Icon="@Icons.Material.Filled.MenuBook">
                @L["Nav_Receitas"]
            </MudNavLink>
            <MudNavLink Href="@Lang.U("/modelos")"
                        Icon="@Icons.Material.Filled.ContentCopy">
                @L["Nav_Modelos"]
            </MudNavLink>
            <MudNavLink Href="@Lang.U("/compras")"
                        Icon="@Icons.Material.Filled.ShoppingCart">
                @L["Nav_ListaCompras"]
            </MudNavLink>
            <MudNavLink Href="@Lang.U("/planner")"
                        Icon="@Icons.Material.Filled.CheckCircleOutline">
                @L["Nav_Planner"]
            </MudNavLink>
            <MudNavLink Href="@Lang.U("/calendario")"
                        Icon="@Icons.Material.Filled.EditCalendar">
                @L["Nav_Calendario"]
            </MudNavLink>
            <MudNavLink Href="@Lang.U("/familia")"
                        Icon="@Icons.Material.Filled.People">
                @L["Nav_Familia"]
            </MudNavLink>
            <MudDivider Class="my-2" />
            <AuthorizeView Roles="Owner">
                <MudNavLink Href="@Lang.U("/empresa")"
                            Icon="@Icons.Material.Filled.Home">
                    @L["Nav_Empresa"]
                </MudNavLink>
                <MudNavLink Href="@Lang.U("/assinatura")"
                            Icon="@Icons.Material.Filled.CreditCard">
                    @L["Nav_Assinatura"]
                </MudNavLink>
            </AuthorizeView>
            <MudNavLink Href="@Lang.U("/configuracoes")"
                        Icon="@Icons.Material.Filled.Settings">
                @L["Nav_Configuracoes"]
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private const string PersistKey = "public_lang";
    private const string ThemeKey = "hp-theme";
    private PersistingComponentStateSubscription _langSub;
    private bool _drawerAberto = true;

    private bool _isDark;
    private string _temaNome = "sage";
    private MudTheme _temaAtivo = HomePlannerTheme.Tema;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var temaSalvo = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeKey);
            if (!string.IsNullOrEmpty(temaSalvo) && temaSalvo != _temaNome)
                await AplicarTema(temaSalvo);
        }
    }

    private async Task AplicarTema(string nome)
    {
        _temaNome = nome;
        (_temaAtivo, _isDark) = nome switch
        {
            "plum"   => (HomePlannerTheme.PlumBlush,  false),
            "carbon" => (HomePlannerTheme.CarbonMint, true),
            _        => (HomePlannerTheme.Tema,       false),
        };

        // Aplica a class CSS no <body> para as variáveis --hp-* customizadas.
        var cssClass = nome switch
        {
            "plum"   => "theme-plum",
            "carbon" => "theme-carbon",
            _        => "",
        };
        await JS.InvokeVoidAsync("eval",
            "document.body.className = document.body.className.replace(/theme-\\S+/g, '').trim(); " +
            (string.IsNullOrEmpty(cssClass) ? "" : $"document.body.classList.add('{cssClass}');"));

        await JS.InvokeVoidAsync("localStorage.setItem", ThemeKey, nome);
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        // Carrega o idioma do SSR para o circuit interativo (HttpContext é null no circuit).
        _langSub = PersistentState.RegisterOnPersisting(PersistLang);

        if (PersistentState.TryTakeFromJson<string>(PersistKey, out var persisted)
            && persisted is not null)
            Lang.SetLang(persisted);
        else
            Lang.SetLang(Lang.Lang);
    }

    private Task PersistLang()
    {
        PersistentState.PersistAsJson(PersistKey, Lang.Lang);
        return Task.CompletedTask;
    }

    private void ToggleDrawer() => _drawerAberto = !_drawerAberto;

    public void Dispose() => _langSub.Dispose();
}
