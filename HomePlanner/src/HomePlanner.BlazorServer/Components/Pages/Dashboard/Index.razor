@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@using HomePlanner.BlazorServer.Services
@inject IStringLocalizer<SharedResource> L
@inject PublicLanguageService Lang

<PageTitle>Dashboard — HomePlanner</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true"
         Style="font-family:'Fraunces',serif; font-weight:300; color:#4A6B5C;">
    @L["Dashboard_Saudacao"]
</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    @DateTime.Today.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("pt-BR"))
</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Class="hover-card" Style="cursor:pointer; border-top: 4px solid #4A6B5C;"
                 @onclick='@(() => Nav.NavigateTo("/cardapio"))'>
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"
                         Style="color:#4A6B5C; font-size:2.5rem;" />
                <MudText Typo="Typo.h6" Class="mt-2">Cardápio</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Planeje as refeições da semana
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Class="hover-card" Style="cursor:pointer; border-top: 4px solid #C97B5A;"
                 @onclick='@(() => Nav.NavigateTo("/receitas"))'>
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                         Style="color:#C97B5A; font-size:2.5rem;" />
                <MudText Typo="Typo.h6" Class="mt-2">Receitas</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_totalReceitas receitas cadastradas
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Class="hover-card" Style="cursor:pointer; border-top: 4px solid #7A8278;"
                 @onclick='@(() => Nav.NavigateTo("/modelos"))'>
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.ContentCopy"
                         Style="color:#7A8278; font-size:2.5rem;" />
                <MudText Typo="Typo.h6" Class="mt-2">Modelos</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Semanas favoritas para reusar
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Style="border-top: 4px solid #E8DDD1; opacity: 0.6;">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart"
                         Style="color:#7A8278; font-size:2.5rem;" />
                <MudText Typo="Typo.h6" Class="mt-2">Lista de Compras</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Em breve
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudDivider Class="my-6" />

<MudText Typo="Typo.h6" GutterBottom="true">Esta semana</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.CalendarMonth"
           Href="/cardapio">
    Ver cardápio da semana
</MudButton>

@code {
    [Inject] NavigationManager Nav { get; set; } = null!;
    [Inject] IReceitaService ReceitaService { get; set; } = null!;

    private int _totalReceitas;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ReceitaService.ListarAsync(
            new ReceitaFiltroDTO { Pagina = 1, TamanhoPagina = 1 });
        _totalReceitas = resultado.Total;
    }
}
