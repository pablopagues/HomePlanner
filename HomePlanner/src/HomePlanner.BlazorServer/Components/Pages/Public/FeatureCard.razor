@* Card de funcionalidade reutilizável na landing *@

<MudPaper Class="pa-6" Elevation="0"
          Style="height:100%; border-radius:12px; background:#FFFFFF; border:1px solid #E8DDD1;">
    <MudIcon Icon="@Icon" Style="@($"font-size:2.5rem; color:{Cor};")" Class="mb-3" />
    <MudText Typo="Typo.h6" GutterBottom="true">@Titulo</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Descricao</MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Descricao { get; set; } = string.Empty;
    [Parameter] public string Cor { get; set; } = "#4A6B5C";
}
