@* Dialog de criação/edição de tarefa *@
@using Application.HomePlanner.DTOs.Planner
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(Dto.Id == 0 ? L["Planner_Nova"] : L["Planner_Editar"])
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="Dto.Titulo" Label="@L["Planner_TituloLabel"]"
                          Required="true" Variant="Variant.Outlined" />

            <MudTextField @bind-Value="Dto.Descricao" Label="@L["Planner_DescricaoLabel"]"
                          Lines="2" AutoGrow="true" Variant="Variant.Outlined" />

            <MudDatePicker @bind-Date="_dataPrevista" Label="@L["Planner_DataLabel"]"
                           Variant="Variant.Outlined" Editable="true" />

            <MudStack Row="true" Spacing="3">
                <MudTimePicker @bind-Time="_horaInicio" Label="@L["Planner_HoraInicioLabel"]"
                               Variant="Variant.Outlined" Editable="true" Clearable="true"
                               AmPm="false" PickerVariant="PickerVariant.Dialog" AutoClose="true"
                               Class="flex-grow-1" />
                <MudTimePicker @bind-Time="_horaFim" Label="@L["Planner_HoraFimLabel"]"
                               Variant="Variant.Outlined" Editable="true" Clearable="true"
                               AmPm="false" PickerVariant="PickerVariant.Dialog" AutoClose="true"
                               Class="flex-grow-1" />
            </MudStack>

            @* Antecedência do lembrete — sempre visível; só habilita com hora de início
               (sem hora o lembrete não dispara). *@
            <MudSelect T="int" @bind-Value="_antecedencia" Label="@L["Planner_AlertaLabel"]"
                       Variant="Variant.Outlined" Disabled="@(!_horaInicio.HasValue)"
                       HelperText="@(_horaInicio.HasValue ? null : L["Alerta_PrecisaHora"].Value)">
                @foreach (var min in OpcoesAntecedencia)
                {
                    <MudSelectItem T="int" Value="@min">@TextoAntecedencia(min)</MudSelectItem>
                }
            </MudSelect>

            @* Filho só atribui tarefas a si mesmo — o responsável é definido no servidor. *@
            @if (!Restrito)
            {
                <MudSelect T="string" @bind-Value="Dto.ResponsavelUsuarioId"
                           Label="@L["Planner_ResponsavelLabel"]" Clearable="true"
                           Variant="Variant.Outlined">
                    @foreach (var m in Membros)
                    {
                        <MudSelectItem T="string" Value="@m.UsuarioId">@m.Nome</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudSelect T="Recorrencia" @bind-Value="Dto.Recorrencia"
                       Label="@L["Planner_RecorrenciaLabel"]" Variant="Variant.Outlined">
                <MudSelectItem T="Recorrencia" Value="Recorrencia.Nenhuma">@L["Recorrencia_Nenhuma"]</MudSelectItem>
                <MudSelectItem T="Recorrencia" Value="Recorrencia.Diaria">@L["Recorrencia_Diaria"]</MudSelectItem>
                <MudSelectItem T="Recorrencia" Value="Recorrencia.Semanal">@L["Recorrencia_Semanal"]</MudSelectItem>
                <MudSelectItem T="Recorrencia" Value="Recorrencia.Mensal">@L["Recorrencia_Mensal"]</MudSelectItem>
            </MudSelect>

            @* No Mural a tarefa é sempre da família — privada nunca apareceria no tablet. *@
            @if (!Mural)
            {
                <MudSwitch T="bool" Value="@_privada"
                           ValueChanged="@((bool v) => { _privada = v; Dto.Visibilidade = v ? VisibilidadeTarefa.Privada : VisibilidadeTarefa.Familia; })"
                           Label="@L["Planner_PrivadaLabel"]" Color="Color.Secondary" />
            }

            @* Notificar pais (Owner/Membro) no lembrete — não faz sentido em tarefa privada. *@
            @if (!_privada)
            {
                <MudSwitch T="bool" @bind-Value="Dto.NotificarResponsaveis"
                           Label="@L["Planner_NotificarPaisLabel"]" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">@L["Btn_Cancelar"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirmar">
            @L["Btn_Salvar"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public TarefaPersistenciaDTO Dto { get; set; } = null!;
    [Parameter, EditorRequired] public List<MembroFamiliaDTO> Membros { get; set; } = null!;

    /// <summary>Papel restrito (Filho): não escolhe responsável, só cria para si.</summary>
    [Parameter] public bool Restrito { get; set; }

    /// <summary>Aberto a partir do Modo Mural: só criação, sempre visível à família.</summary>
    [Parameter] public bool Mural { get; set; }

    private DateTime? _dataPrevista;
    private TimeSpan? _horaInicio;
    private TimeSpan? _horaFim;
    private bool _privada;

    /// <summary>-1 = padrão da família (null no DTO).</summary>
    private const int PadraoFamilia = -1;
    private static readonly int[] OpcoesFixas = { PadraoFamilia, 15, 30, 60, 480, 1440 };
    private int _antecedencia = PadraoFamilia;

    /// <summary>Opções do dropdown; inclui um valor fora da lista se a tarefa já tiver um (ex.: via API).</summary>
    private IEnumerable<int> OpcoesAntecedencia =>
        OpcoesFixas.Contains(_antecedencia) ? OpcoesFixas : OpcoesFixas.Append(_antecedencia).OrderBy(m => m);

    private string TextoAntecedencia(int min) => min switch
    {
        PadraoFamilia => L["Alerta_PadraoFamilia"],
        60 => L["Alerta_1Hora"],
        1440 => L["Alerta_1Dia"],
        _ when min >= 60 && min % 60 == 0 => string.Format(L["Alerta_HorasAntes"], min / 60),
        _ => string.Format(L["Alerta_MinutosAntes"], min),
    };

    protected override void OnInitialized()
    {
        _antecedencia = Dto.MinutosAntecedenciaLembrete ?? PadraoFamilia;
        if (Mural) Dto.Visibilidade = VisibilidadeTarefa.Familia;
        _dataPrevista = Dto.DataPrevista?.ToDateTime(TimeOnly.MinValue);
        _horaInicio = Dto.HoraInicio?.ToTimeSpan();
        _horaFim = Dto.HoraFim?.ToTimeSpan();
        _privada = Dto.Visibilidade == VisibilidadeTarefa.Privada;
    }

    private void Confirmar()
    {
        Dto.DataPrevista = _dataPrevista.HasValue
            ? DateOnly.FromDateTime(_dataPrevista.Value)
            : null;
        Dto.HoraInicio = _horaInicio.HasValue ? TimeOnly.FromTimeSpan(_horaInicio.Value) : null;
        Dto.HoraFim = _horaFim.HasValue ? TimeOnly.FromTimeSpan(_horaFim.Value) : null;
        Dto.MinutosAntecedenciaLembrete = _antecedencia == PadraoFamilia ? null : _antecedencia;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancelar() => MudDialog.Cancel();
}
