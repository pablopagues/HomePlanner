@page "/planner"
@page "/tasks"
@page "/tareas"
@attribute [Authorize]
@using Application.HomePlanner.DTOs.Planner
@using Application.HomePlanner.Services.Planner
@inject ITarefaService Service
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject EstadoMural Mural

<PageTitle>@L["Planner_Titulo"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5" Style="font-family:'Fraunces',serif; font-weight:300;">
        @L["Planner_Titulo"]
    </MudText>
    @if (!Mural.Ativo)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => AbrirEditor(null))">
            @L["Planner_Nova"]
        </MudButton>
    }
</MudStack>

@* ── Filtros ────────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:var(--mud-palette-background-gray); border-radius:10px;">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudChipSet T="string" SelectedValue="_filtroStatus"
                    SelectedValueChanged="@(async (string v) => { _filtroStatus = v; await CarregarAsync(); })"
                    SelectionMode="SelectionMode.SingleSelection" Variant="Variant.Filled">
            <MudChip T="string" Value="@("pendentes")">@L["Planner_Pendentes"]</MudChip>
            <MudChip T="string" Value="@("concluidas")">@L["Planner_Concluidas"]</MudChip>
            <MudChip T="string" Value="@("todas")">@L["Planner_Todas"]</MudChip>
        </MudChipSet>

        @if (!_restrito && _membros.Count > 0)
        {
            <div class="ml-auto">
                <SeletorMembro Membros="_membros" SelecionadoId="@_responsavelFiltro"
                               SelecionadoIdChanged="@(async (string? v) => { _responsavelFiltro = v; await CarregarAsync(); })" />
            </div>
        }
    </MudStack>
</MudPaper>

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_tarefas.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["Planner_Nenhuma"]</MudAlert>
}
else
{
    <MudStack Spacing="2">
        @foreach (var t in _tarefas)
        {
            <MudPaper Class="pa-3"
                      Style="@($"border-radius:8px; border:1px solid var(--mud-palette-lines-default); background:{(t.Concluida ? "var(--mud-palette-background-gray)" : "var(--mud-palette-surface)")};")"
                      Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudCheckBox T="bool" Value="@t.Concluida"
                                 ValueChanged="@(async (bool v) => await ConcluirAsync(t, v))"
                                 ReadOnly="Mural.Ativo" Color="Color.Success" />

                    <MudStack Spacing="0" Style="flex:1; min-width:0;">
                        <MudText Typo="Typo.body1"
                                 Style="@(t.Concluida ? "text-decoration:line-through; opacity:0.55;" : "font-weight:500;")">
                            @t.Titulo
                        </MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            @if (t.DataPrevista.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small"
                                             Style="vertical-align:middle; font-size:0.9rem;" />
                                    @t.DataPrevista.Value.ToString("dd/MM/yyyy")
                                    @if (t.HoraInicio.HasValue)
                                    {
                                        <span> · @FormatarHorario(t.HoraInicio, t.HoraFim)</span>
                                    }
                                </MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(t.ResponsavelNome))
                            {
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <AvatarUsuario UsuarioId="@t.ResponsavelUsuarioId" Nome="@t.ResponsavelNome"
                                                   Versao="@t.ResponsavelFotoVersao" Px="22" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@t.ResponsavelNome</MudText>
                                </MudStack>
                            }
                            @if (t.Recorrencia != Recorrencia.Nenhuma)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary"
                                         Icon="@Icons.Material.Filled.Repeat">
                                    @NomeRecorrencia(t.Recorrencia)
                                </MudChip>
                            }
                            @if (t.Visibilidade == VisibilidadeTarefa.Privada)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small"
                                         Color="Color.Secondary"
                                         Style="font-size:0.9rem;" />
                            }
                        </MudStack>
                    </MudStack>

                    @if (!Mural.Ativo)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => AbrirEditor(t))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => ConfirmarExclusao(t))" />
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {
    private List<TarefaListaDTO> _tarefas = [];
    private List<MembroFamiliaDTO> _membros = [];
    private bool _carregando = true;
    private bool _restrito;
    private string? _responsavelFiltro;
    private string _filtroStatus = "pendentes";

    protected override async Task OnInitializedAsync()
    {
        _membros = (await Service.ListarMembrosFamiliaAsync()).ToList();
        _restrito = Service.UsuarioRestritoAsProprias;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        var filtro = new TarefaFiltroDTO
        {
            Pagina = 1, TamanhoPagina = 200,
            ResponsavelUsuarioId = _responsavelFiltro,
            Concluida = _filtroStatus switch
            {
                "pendentes"  => false,
                "concluidas" => true,
                _            => null,
            },
        };
        var r = await Service.ListarAsync(filtro);
        _tarefas = r.Itens.ToList();
        _carregando = false;
    }

    private async Task ConcluirAsync(TarefaListaDTO t, bool concluida)
    {
        var r = await Service.ConcluirAsync(t.Id, concluida);
        if (r.Sucesso) await CarregarAsync();
        else Snackbar.Add(string.Join(", ", r.Erros), Severity.Error);
    }

    private async Task AbrirEditor(TarefaListaDTO? tarefa)
    {
        var dto = tarefa is null
            ? new TarefaPersistenciaDTO()
            : new TarefaPersistenciaDTO
            {
                Id                   = tarefa.Id,
                Titulo               = tarefa.Titulo,
                Descricao            = tarefa.Descricao,
                DataPrevista         = tarefa.DataPrevista,
                HoraInicio           = tarefa.HoraInicio,
                HoraFim              = tarefa.HoraFim,
                Recorrencia          = tarefa.Recorrencia,
                Visibilidade         = tarefa.Visibilidade,
                ResponsavelUsuarioId = tarefa.ResponsavelUsuarioId,
                NotificarResponsaveis = tarefa.NotificarResponsaveis,
            };

        var parameters = new DialogParameters<TarefaEditor>
        {
            { x => x.Dto, dto },
            { x => x.Membros, _membros },
            { x => x.Restrito, _restrito },
        };

        var dialog = await Dialog.ShowAsync<TarefaEditor>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var r = await Service.SalvarAsync(dto);
        if (r.Sucesso)
        {
            Snackbar.Add(L["Msg_SalvoOk"], Severity.Success);
            await CarregarAsync();
        }
        else
            Snackbar.Add(string.Join(", ", r.Erros), Severity.Error);
    }

    private async Task ConfirmarExclusao(TarefaListaDTO t)
    {
        var confirm = await Dialog.ShowMessageBox(
            L["Confirmacao_Titulo"],
            L["Planner_ExcluirConfirm"],
            yesText: L["Btn_Excluir"], cancelText: L["Btn_Cancelar"]);

        if (confirm == true)
        {
            var r = await Service.DeletarAsync(t.Id);
            if (r.Sucesso)
            {
                Snackbar.Add(L["Msg_ExcluidoOk"], Severity.Success);
                await CarregarAsync();
            }
            else
                Snackbar.Add(string.Join(", ", r.Erros), Severity.Error);
        }
    }

    private static string FormatarHorario(TimeOnly? inicio, TimeOnly? fim)
    {
        if (!inicio.HasValue) return string.Empty;
        return fim.HasValue
            ? $"{inicio.Value:HH\\:mm}–{fim.Value:HH\\:mm}"
            : inicio.Value.ToString("HH\\:mm");
    }

    private string NomeRecorrencia(Recorrencia r) => r switch
    {
        Recorrencia.Diaria  => L["Recorrencia_Diaria"],
        Recorrencia.Semanal => L["Recorrencia_Semanal"],
        Recorrencia.Mensal  => L["Recorrencia_Mensal"],
        _                   => L["Recorrencia_Nenhuma"],
    };
}
