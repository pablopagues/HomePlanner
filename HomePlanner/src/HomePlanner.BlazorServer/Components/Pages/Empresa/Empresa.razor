@page "/empresa"
@page "/company"
@attribute [Authorize(Policy = PoliciesAutorizacao.OwnerOnly)]
@using Application.HomePlanner.DTOs.Empresa
@using Application.HomePlanner.Middleware
@using Application.HomePlanner.Services.Empresa
@using Domain.HomePlanner.Models.Enums
@inject IEmpresaService Service
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Emp_Titulo"] — HomePlanner</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true" Style="font-family:'Fraunces',serif; font-weight:300;">
    <MudIcon Icon="@Icons.Material.Filled.Home" Class="mr-2" />
    @L["Emp_Titulo"]
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@L["Emp_Subtitulo"]</MudText>

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-5 mb-4" Elevation="1" Style="border-radius:10px;">
        <MudText Typo="Typo.h6" Class="mb-4">@L["Emp_SecaoDados"]</MudText>

        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_dto.NomeResponsavel"
                              Label="@L["Emp_NomeResponsavel"]"
                              Required="true" MaxLength="200"
                              Variant="Variant.Outlined"
                              Disabled="@_salvando" />
            </MudItem>

            @* E-mail da conta (somente leitura) — a confirmação fica no Perfil do usuário *@
            <MudItem xs="12">
                <MudTextField Value="@_detalhe.Email"
                              Label="@L["Emp_Email"]"
                              Variant="Variant.Outlined"
                              ReadOnly="true" />
            </MudItem>

            @* País (não editável — determina os preços) *@
            <MudItem xs="12" sm="6">
                <MudTextField Value="@(_detalhe.PaisId == Paises.Canada ? "🇨🇦 Canada" : "🇧🇷 Brasil")"
                              Label="@L["Emp_Pais"]"
                              Variant="Variant.Outlined"
                              Disabled="true"
                              HelperText="@L["Emp_PaisHelperText"]" />
            </MudItem>

            @if (_detalhe.PaisId == Paises.Brasil)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_dto.Cpf"
                                  Label="@L["Emp_Cpf"]"
                                  MaxLength="14"
                                  Variant="Variant.Outlined"
                                  Disabled="@_salvando" />
                </MudItem>
            }
            else if (_detalhe.PaisId == Paises.Canada)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_dto.Province"
                                  Label="@L["Emp_Province"]"
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Disabled="@_salvando" />
                </MudItem>
            }

            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="@SalvarAsync" Disabled="@_salvando">
                    @(_salvando ? L["Emp_Salvando"] : L["Emp_Salvar"])
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private bool _carregando = true;
    private bool _salvando;

    private EmpresaDetalheDTO _detalhe = new();
    private AtualizarEmpresaDTO _dto = new();

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        try
        {
            _detalhe = await Service.ObterAsync();
            _dto = new AtualizarEmpresaDTO
            {
                NomeResponsavel = _detalhe.NomeResponsavel,
                Cpf = _detalhe.Cpf,
                Province = _detalhe.Province,
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["Emp_ErroCarregar"], ex.Message), Severity.Error);
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        try
        {
            var erros = await Service.SalvarDadosAsync(_dto);
            if (erros.Count > 0)
            {
                foreach (var e in erros) Snackbar.Add(e, Severity.Error);
                return;
            }
            Snackbar.Add(L["Emp_SalvoOk"], Severity.Success);
            await CarregarAsync();
        }
        finally { _salvando = false; }
    }
}
