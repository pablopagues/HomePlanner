@page "/configuracoes"
@page "/settings"
@page "/configuracion"
@attribute [Authorize(Policy = "OwnerOnly")]
@using Application.HomePlanner.DTOs.Onboarding
@using Application.HomePlanner.Services.Configuracao
@inject IConfiguracaoFamiliaService Service
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["Cfg_Titulo"] — HomePlanner</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1" Style="font-family:'Fraunces',serif; font-weight:300;">
    @L["Cfg_Titulo"]
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    @L["Cfg_Subtitulo"]
</MudText>

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-6" Elevation="1" Style="border-radius:14px; max-width:560px;">
        <MudStack Spacing="4">
            <MudNumericField @bind-Value="_dto.TamanhoFamiliaPadrao"
                             Label="@L["Onb_TamanhoFamilia"]" Min="1" Max="20"
                             Variant="Variant.Outlined"
                             HelperText="@L["Onb_TamanhoFamiliaAjuda"]" />

            <MudSelect T="string" @bind-Value="_dto.FusoHorario"
                       Label="@L["Onb_FusoHorario"]" Variant="Variant.Outlined">
                <MudSelectItem Value="@("America/Toronto")">America/Toronto (Canadá)</MudSelectItem>
                <MudSelectItem Value="@("America/Sao_Paulo")">America/Sao_Paulo (Brasil)</MudSelectItem>
                <MudSelectItem Value="@("America/Vancouver")">America/Vancouver</MudSelectItem>
                <MudSelectItem Value="@("Europe/Madrid")">Europe/Madrid (Espanha)</MudSelectItem>
            </MudSelect>

            <div>
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Onb_TiposRefeicao"]</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                    @foreach (var tipo in _tiposDisponiveis)
                    {
                        <MudChip T="string"
                                 Variant="@(_dto.TiposRefeicaoAtivos.Contains(tipo) ? Variant.Filled : Variant.Outlined)"
                                 Color="@(_dto.TiposRefeicaoAtivos.Contains(tipo) ? Color.Primary : Color.Default)"
                                 OnClick="@(() => ToggleTipo(tipo))">
                            @NomeTipo(tipo)
                        </MudChip>
                    }
                </MudStack>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       OnClick="SalvarAsync" Disabled="_salvando" Style="align-self:flex-start;">
                @(_salvando ? L["Btn_Salvando"] : L["Btn_Salvar"])
            </MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private ConfiguracaoFamiliaDTO _dto = new();
    private bool _carregando = true;
    private bool _salvando;

    private static readonly string[] _tiposDisponiveis =
        ["CafeManha", "Almoco", "Lanche", "Jantar", "Ceia"];

    protected override async Task OnInitializedAsync()
    {
        _dto = await Service.ObterAsync();
        if (_dto.TiposRefeicaoAtivos.Count == 0)
            _dto.TiposRefeicaoAtivos.Add("Almoco");
        _carregando = false;
    }

    private void ToggleTipo(string tipo)
    {
        if (_dto.TiposRefeicaoAtivos.Contains(tipo))
            _dto.TiposRefeicaoAtivos.Remove(tipo);
        else
            _dto.TiposRefeicaoAtivos.Add(tipo);
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        var r = await Service.SalvarAsync(_dto);
        _salvando = false;

        if (r.Sucesso)
            Snackbar.Add(L["Msg_SalvoOk"], Severity.Success);
        else
            Snackbar.Add(string.Join(", ", r.Erros), Severity.Error);
    }

    private string NomeTipo(string tipo) => tipo switch
    {
        "CafeManha" => L["Refeicao_CafeManha"],
        "Almoco"    => L["Refeicao_Almoco"],
        "Lanche"    => L["Refeicao_Lanche"],
        "Jantar"    => L["Refeicao_Jantar"],
        "Ceia"      => L["Refeicao_Ceia"],
        _           => tipo,
    };
}
