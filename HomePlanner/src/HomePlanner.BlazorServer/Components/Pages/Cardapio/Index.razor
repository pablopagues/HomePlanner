@page "/cardapio"
@page "/cardapio/{DataStr}"
@page "/menu"
@page "/menu/{DataStr}"
@attribute [Authorize]
@using HomePlanner.BlazorServer.Services
@using Application.HomePlanner.Services.Configuracao
@inject IStringLocalizer<SharedResource> L
@inject PublicLanguageService Lang
@inject EstadoMural Mural

<PageTitle>@L["Cardapio_Titulo"]</PageTitle>

@* ── Cabeçalho de navegação semanal ─────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1" Style="border-radius:10px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       OnClick="SemanaAnterior" title="@L["Cardapio_SemanaAnterior"]" />

        <MudStack AlignItems="AlignItems.Center" Spacing="0">
            <MudText Typo="Typo.h6" Style="font-family:'Fraunces',serif; font-weight:300;">
                @L["Cardapio_Periodo", DiaHelper.DiaMes(_dataInicio), DiaHelper.Data(_dataFim)]
            </MudText>
            @if (_dataInicio == SegundaDeHoje())
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L["Cardapio_EstaSemana"]</MudChip>
            }
        </MudStack>

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                       OnClick="IrParaHoje">@L["Cardapio_Hoje"]</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           OnClick="ProximaSemana" title="@L["Cardapio_ProximaSemana"]" />
        </MudStack>
    </MudStack>
</MudPaper>

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ── Rascunho automático da IA aguardando revisão ─────────────── *@
    @if (_rascunho is not null && !Mural.Ativo)
    {
        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.AutoAwesome" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.body2">@L["CardAuto_Banner"]</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           OnClick="RevisarRascunhoAsync">@L["CardAuto_Revisar"]</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="DescartarRascunhoAsync">@L["CardAuto_Descartar"]</MudButton>
            </MudStack>
        </MudAlert>
    }

    @* ── Grade semanal ─────────────────────────────────────────── *@
    @* Cada célula é uma zona de soltar: arrastar um prato para outra célula move-o
       (ou troca com o prato que estiver lá). Desligado no Modo Mural. *@
    <MudDropContainer T="RefeicaoDiaDTO" @ref="_drop"
                      Items="@RefeicoesComPrato"
                      ItemsSelector="@((r, zona) => zona == Zona(r.DiaSemana, r.TipoRefeicao))"
                      ItemDisabled="@(_ => Mural.Ativo)"
                      ItemDropped="SoltarAsync"
                      CanDropClass="cardapio-pode-soltar"
                      ItemDraggingClass="cardapio-arrastando">
        <ChildContent>
    <div style="display:grid; grid-template-columns: 90px repeat(7, 1fr); gap:8px; overflow-x:auto;">

        @* Linha de cabeçalho — nomes dos dias *@
        <div></div>
        @foreach (var dia in _dias)
        {
            <div style="text-align:center; padding:8px 4px;">
                <MudText Typo="Typo.subtitle2" Style="color:var(--mud-palette-primary); font-weight:600;">
                    @dia.NomeCurto
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @DiaHelper.DiaMes(dia.Data)
                </MudText>
                @if (dia.Data == DateOnly.FromDateTime(DateTime.Today))
                {
                    <div style="width:6px;height:6px;border-radius:50%;background:var(--mud-palette-secondary);margin:2px auto;"></div>
                }
            </div>
        }

        @* Linhas de refeições *@
        @foreach (var tipo in _tiposAtivos)
        {
            <div style="display:flex; align-items:center; padding:8px 4px;">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary); font-weight:500; writing-mode:horizontal-tb;">
                    @NomeTipo(tipo)
                </MudText>
            </div>

            @foreach (var dia in _dias)
            {
                var refeicao = ObterRefeicao(dia.DiaSemana, tipo);
                <MudDropZone T="RefeicaoDiaDTO" Identifier="@Zona(dia.DiaSemana, tipo)"
                             Class="cardapio-celula">
                    @if (refeicao?.ReceitaId.HasValue != true && !Mural.Ativo)
                    {
                        <MudPaper @onclick="@(() => AbrirSeletor(dia, tipo, refeicao))"
                                  Style="cursor:pointer; height:100%; min-height:70px; border-radius:8px; border:1px dashed var(--mud-palette-lines-default); background:transparent; display:flex; align-items:center; justify-content:center;"
                                  Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.Add"
                                     Style="color:var(--mud-palette-text-disabled);" Size="Size.Small" />
                        </MudPaper>
                    }
                </MudDropZone>
            }
        }
    </div>
        </ChildContent>
        <ItemRenderer>
            @{ var refeicao = context; }
            <MudPaper @onclick="@(() => AbrirSeletor(DiaDe(refeicao.DiaSemana), refeicao.TipoRefeicao, refeicao))"
                      Style="@($"cursor:{(Mural.Ativo ? "default" : "grab")}; height:100%; min-height:70px; border-radius:8px; padding:8px; background:var(--mud-palette-primary-hover); border:1px solid var(--mud-palette-primary); position:relative;")"
                      Elevation="0">
                @if (!Mural.Ativo)
                {
                    @* Atalho para o detalhe da receita — não abre o seletor da célula *@
                    <span @onclick:stopPropagation="true"
                          style="position:absolute; top:2px; right:2px; z-index:1;">
                        <MudIconButton Icon="@Icons.Material.Filled.MenuBook"
                                       Size="Size.Small" Color="Color.Primary"
                                       Href="@UrlReceita(refeicao.ReceitaId!.Value)"
                                       title="@L["Sug_VerReceita"]"
                                       Style="background:var(--mud-palette-surface); padding:4px;" />
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(refeicao.ReceitaImagemSrc))
                {
                    <img src="@refeicao.ReceitaImagemSrc" alt="" draggable="false"
                         style="width:100%;height:50px;object-fit:cover;border-radius:6px;margin-bottom:4px;" />
                }
                <MudText Typo="Typo.caption" Style="font-weight:500; line-height:1.2; display:block;">
                    @refeicao.ReceitaNome
                </MudText>
                @if (refeicao.PorcoesDesejadas.HasValue)
                {
                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary); font-size:0.7rem;">
                        @refeicao.PorcoesDesejadas @L["App_PorcoesAbrev"]
                    </MudText>
                }
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>

    @if (!Mural.Ativo)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
            <MudIcon Icon="@Icons.Material.Filled.OpenWith" Size="Size.Small" Style="vertical-align:middle;" />
            @L["Cardapio_DicaArrastar"]
        </MudText>
    }

    @* ── Ações da semana ─────────────────────────────────────────── *@
    @if (!Mural.Ativo)
    {
        <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
            @if (_podeGerarIA)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           OnClick="GerarComIAAsync">
                    @L["CardIA_Botao"]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ContentCopy"
                       OnClick="CopiarSemana">
                @L["Cardapio_CopiarSemana"]
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.BookmarkAdd"
                       OnClick="SalvarComoModelo">
                @L["Cardapio_SalvarModelo"]
            </MudButton>
        </MudStack>
    }
}

<style>
    .cardapio-celula { min-height:80px; height:100%; display:flex; flex-direction:column; border-radius:8px; }
    .cardapio-celula > .mud-drop-item { flex:1; }
    .cardapio-pode-soltar { outline:2px dashed var(--mud-palette-primary); outline-offset:2px; }
    .cardapio-arrastando { opacity:0.5; }
</style>

@code {
    [Parameter] public string? DataStr { get; set; }

    [Inject] ICardapioService CardapioService { get; set; } = null!;
    [Inject] IModeloSemanaService ModeloService { get; set; } = null!;
    [Inject] IConfiguracaoFamiliaService ConfigService { get; set; } = null!;
    [Inject] IDialogService Dialog { get; set; } = null!;
    [Inject] ISnackbar Snackbar { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;
    [Inject] IJSRuntime JS { get; set; } = null!;
    [Inject] ICardapioIAService CardapioIA { get; set; } = null!;
    [Inject] ICardapioAutomaticoService CardapioAuto { get; set; } = null!;

    private bool _podeGerarIA;
    private RascunhoCardapioIADTO? _rascunho;

    protected override async Task OnInitializedAsync()
        => _podeGerarIA = await CardapioIA.PodeGerarAsync();

    private Task GerarComIAAsync() => AbrirDialogoIAAsync(null);

    private Task RevisarRascunhoAsync() => AbrirDialogoIAAsync(_rascunho);

    private async Task DescartarRascunhoAsync()
    {
        if (_rascunho is null) return;
        var r = await CardapioAuto.DescartarRascunhoAsync(_rascunho.Id);
        if (r.Sucesso)
        {
            _rascunho = null;
            Snackbar.Add(L["CardAuto_Descartado"], Severity.Info);
        }
        else
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
    }

    private async Task AbrirDialogoIAAsync(RascunhoCardapioIADTO? rascunho)
    {
        var parameters = new DialogParameters<GerarCardapioIADialog>
        {
            { x => x.DataInicio,  _dataInicio },
            { x => x.TiposAtivos, _tiposAtivos },
            { x => x.Rascunho,    rascunho },
        };
        var dialog = await Dialog.ShowAsync<GerarCardapioIADialog>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        Snackbar.Add(L["CardIA_Aplicado"], Severity.Success);
        await CarregarSemanaAsync(silencioso: true);
    }

    private DateOnly _dataInicio;
    private DateOnly _dataFim;
    private CardapioSemanaDTO? _cardapio;
    private bool _carregando = true;

    private TipoRefeicao[] _tiposAtivos = [TipoRefeicao.Almoco]; // fallback até carregar a config

    private record DiaInfo(DiaSemana DiaSemana, string NomeCurto, DateOnly Data);
    private List<DiaInfo> _dias = [];

    protected override async Task OnParametersSetAsync()
    {
        await CarregarTiposAtivosAsync();

        _dataInicio = DataStr is not null && DateOnly.TryParse(DataStr, out var d)
            ? d
            : SegundaDeHoje();

        _dataFim = _dataInicio.AddDays(6);
        _dias = Enumerable.Range(0, 7)
            .Select(i =>
            {
                var data = _dataInicio.AddDays(i);
                var diaSemana = (DiaSemana)(i + 1);
                return new DiaInfo(diaSemana, DiaHelper.NomeCurto(diaSemana), data);
            })
            .ToList();

        await CarregarSemanaAsync();
    }

    private async Task CarregarTiposAtivosAsync()
    {
        var cfg = await ConfigService.ObterAsync();
        var tipos = cfg.TiposRefeicaoAtivos
            .Select(t => Enum.TryParse<TipoRefeicao>(t, out var tipo) ? tipo : (TipoRefeicao?)null)
            .Where(t => t.HasValue)
            .Select(t => t!.Value)
            .OrderBy(t => (int)t) // ordem cronológica do dia: Café → Almoço → Lanche → Jantar → Ceia
            .ToArray();

        if (tipos.Length > 0)
            _tiposAtivos = tipos;
    }

    // silencioso: recarrega sem esconder a grade (após arrastar, para não piscar).
    private async Task CarregarSemanaAsync(bool silencioso = false)
    {
        if (!silencioso) _carregando = true;
        var r = await CardapioService.ObterOuCriarSemanaAsync(_dataInicio);
        _cardapio = r.Sucesso ? r.Valor : null;
        if (!r.Sucesso)
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
        _rascunho = _podeGerarIA ? await CardapioAuto.ObterRascunhoProntoAsync(_dataInicio) : null;
        _carregando = false;
        if (silencioso) _drop?.Refresh();
    }

    private RefeicaoDiaDTO? ObterRefeicao(DiaSemana dia, TipoRefeicao tipo)
        => _cardapio?.Refeicoes.FirstOrDefault(r => r.DiaSemana == dia && r.TipoRefeicao == tipo);

    // ── Arrastar e soltar ────────────────────────────────────────────────────
    private MudDropContainer<RefeicaoDiaDTO>? _drop;

    // Só pratos de refeições visíveis (tipos ativos) viram itens arrastáveis.
    private IEnumerable<RefeicaoDiaDTO> RefeicoesComPrato =>
        _cardapio?.Refeicoes.Where(r => r.ReceitaId.HasValue && _tiposAtivos.Contains(r.TipoRefeicao)) ?? [];

    private static string Zona(DiaSemana dia, TipoRefeicao tipo) => $"{(int)dia}-{(int)tipo}";

    private DiaInfo DiaDe(DiaSemana dia) => _dias.First(d => d.DiaSemana == dia);

    private async Task SoltarAsync(MudItemDropInfo<RefeicaoDiaDTO> info)
    {
        if (Mural.Ativo || info.Item is null || info.DropzoneIdentifier is null) return;

        var partes = info.DropzoneIdentifier.Split('-');
        var destinoDia  = (DiaSemana)int.Parse(partes[0]);
        var destinoTipo = (TipoRefeicao)int.Parse(partes[1]);

        await MoverAsync(info.Item.DiaSemana, info.Item.TipoRefeicao, destinoDia, destinoTipo);
    }

    private async Task MoverAsync(DiaSemana diaOrigem, TipoRefeicao tipoOrigem, DiaSemana diaDestino, TipoRefeicao tipoDestino)
    {
        var r = await CardapioService.MoverRefeicaoAsync(new MoverRefeicaoCommand
        {
            DataInicio  = _dataInicio,
            DiaOrigem   = diaOrigem,
            TipoOrigem  = tipoOrigem,
            DiaDestino  = diaDestino,
            TipoDestino = tipoDestino,
        });
        if (!r.Sucesso)
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);

        // Recarrega mesmo em falha, para desfazer o movimento visual.
        await CarregarSemanaAsync(silencioso: true);
    }

    private async Task AbrirSeletor(DiaInfo dia, TipoRefeicao tipo, RefeicaoDiaDTO? refeicao)
    {
        if (Mural.Ativo) return; // somente-leitura no Modo Mural

        var parameters = new DialogParameters<SeletorReceita>
        {
            { x => x.DiaSemana,     dia.DiaSemana },
            { x => x.TipoRefeicao,  tipo },
            { x => x.ReceitaIdAtual, refeicao?.ReceitaId },
            { x => x.PorcoesAtual,  refeicao?.PorcoesDesejadas ?? 4 },
            { x => x.TiposAtivos,   _tiposAtivos },
        };

        var dialog = await Dialog.ShowAsync<SeletorReceita>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        // "Mover para…" (alternativa ao arrastar, útil no celular).
        if (result.Data is SeletorReceita.MoverPara mover)
        {
            await MoverAsync(dia.DiaSemana, tipo, mover.Dia, mover.Tipo);
            return;
        }

        var (receitaId, porcoes) = ((int?, int))result.Data!;

        var cmd = new DefinirRefeicaoCommand
        {
            DataInicio       = _dataInicio,
            DiaSemana        = dia.DiaSemana,
            TipoRefeicao     = tipo,
            ReceitaId        = receitaId,
            PorcoesDesejadas = receitaId.HasValue ? porcoes : null,
        };

        var r = await CardapioService.DefinirRefeicaoAsync(cmd);
        if (r.Sucesso)
            await CarregarSemanaAsync();
        else
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
    }

    private string UrlReceita(int receitaId) =>
        $"/receitas/{receitaId}?voltar={Uri.EscapeDataString($"/cardapio/{_dataInicio:yyyy-MM-dd}")}";

    private void SemanaAnterior() =>
        Nav.NavigateTo($"/cardapio/{_dataInicio.AddDays(-7):yyyy-MM-dd}");

    private void ProximaSemana() =>
        Nav.NavigateTo($"/cardapio/{_dataInicio.AddDays(7):yyyy-MM-dd}");

    private void IrParaHoje() =>
        Nav.NavigateTo($"/cardapio/{SegundaDeHoje():yyyy-MM-dd}");

    private async Task CopiarSemana()
    {
        var destino = _dataInicio.AddDays(7);
        var r = await CardapioService.CopiarSemanaAsync(_dataInicio, destino);
        if (r.Sucesso)
        {
            Snackbar.Add(L["Cardapio_SemanaCopiadaPara", DiaHelper.DiaMes(destino)], Severity.Success);
            Nav.NavigateTo($"/cardapio/{destino:yyyy-MM-dd}");
        }
        else
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
    }

    private async Task SalvarComoModelo()
    {
        var result = await JS.InvokeAsync<string?>("prompt",
            L["Cardapio_NomeModelo"].Value, L["Cardapio_NomeModeloPadrao"].Value);

        if (string.IsNullOrWhiteSpace(result)) return;

        var r = await ModeloService.SalvarPlanejamentoComoModeloAsync(_dataInicio, result);
        if (r.Sucesso)
            Snackbar.Add(L["Cardapio_ModeloSalvo"], Severity.Success);
        else
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
    }

    private static DateOnly SegundaDeHoje()
    {
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        var diasAteSegunda = ((int)hoje.DayOfWeek - 1 + 7) % 7;
        return hoje.AddDays(-diasAteSegunda);
    }

    private string NomeTipo(TipoRefeicao t) => t switch
    {
        TipoRefeicao.CafeManha => L["Refeicao_CafeManha"],
        TipoRefeicao.Almoco    => L["Refeicao_Almoco"],
        TipoRefeicao.Lanche    => L["Refeicao_Lanche"],
        TipoRefeicao.Jantar    => L["Refeicao_Jantar"],
        TipoRefeicao.Ceia      => L["Refeicao_Ceia"],
        _                      => t.ToString(),
    };
}
