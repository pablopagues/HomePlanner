@page "/cardapio"
@page "/cardapio/{DataStr}"
@page "/menu"
@page "/menu/{DataStr}"
@attribute [Authorize]
@using HomePlanner.BlazorServer.Services
@using Application.HomePlanner.Services.Configuracao
@inject IStringLocalizer<SharedResource> L
@inject PublicLanguageService Lang
@inject EstadoMural Mural

<PageTitle>@L["Cardapio_Titulo"]</PageTitle>

@* ── Cabeçalho de navegação semanal ─────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1" Style="border-radius:10px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       OnClick="SemanaAnterior" title="Semana anterior" />

        <MudStack AlignItems="AlignItems.Center" Spacing="0">
            <MudText Typo="Typo.h6" Style="font-family:'Fraunces',serif; font-weight:300;">
                @_dataInicio.ToString("dd/MM") a @_dataFim.ToString("dd/MM/yyyy")
            </MudText>
            @if (_dataInicio == SegundaDeHoje())
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L["Cardapio_EstaSemana"]</MudChip>
            }
        </MudStack>

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                       OnClick="IrParaHoje">@L["Cardapio_Hoje"]</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           OnClick="ProximaSemana" title="Próxima semana" />
        </MudStack>
    </MudStack>
</MudPaper>

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ── Grade semanal ─────────────────────────────────────────── *@
    <div style="display:grid; grid-template-columns: 90px repeat(7, 1fr); gap:8px; overflow-x:auto;">

        @* Linha de cabeçalho — nomes dos dias *@
        <div></div>
        @foreach (var dia in _dias)
        {
            <div style="text-align:center; padding:8px 4px;">
                <MudText Typo="Typo.subtitle2" Style="color:var(--mud-palette-primary); font-weight:600;">
                    @dia.NomeCurto
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @dia.Data.ToString("dd/MM")
                </MudText>
                @if (dia.Data == DateOnly.FromDateTime(DateTime.Today))
                {
                    <div style="width:6px;height:6px;border-radius:50%;background:var(--mud-palette-secondary);margin:2px auto;"></div>
                }
            </div>
        }

        @* Linhas de refeições *@
        @foreach (var tipo in _tiposAtivos)
        {
            <div style="display:flex; align-items:center; padding:8px 4px;">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary); font-weight:500; writing-mode:horizontal-tb;">
                    @NomeTipo(tipo)
                </MudText>
            </div>

            @foreach (var dia in _dias)
            {
                var refeicao = ObterRefeicao(dia.DiaSemana, tipo);
                <div style="min-height:80px;">
                    @if (refeicao?.ReceitaId.HasValue == true)
                    {
                        <MudPaper @onclick="@(() => AbrirSeletor(dia, tipo, refeicao))"
                                  Style="cursor:pointer; height:100%; border-radius:8px; padding:8px; background:var(--mud-palette-primary-hover); border:1px solid var(--mud-palette-primary);"
                                  Elevation="0">
                            @if (!string.IsNullOrWhiteSpace(refeicao.ReceitaImagemSrc))
                            {
                                <img src="@refeicao.ReceitaImagemSrc" alt=""
                                     style="width:100%;height:50px;object-fit:cover;border-radius:6px;margin-bottom:4px;" />
                            }
                            <MudText Typo="Typo.caption" Style="font-weight:500; line-height:1.2; display:block;">
                                @refeicao.ReceitaNome
                            </MudText>
                            @if (refeicao.PorcoesDesejadas.HasValue)
                            {
                                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary); font-size:0.7rem;">
                                    @refeicao.PorcoesDesejadas porç.
                                </MudText>
                            }
                        </MudPaper>
                    }
                    else if (!Mural.Ativo)
                    {
                        <MudPaper @onclick="@(() => AbrirSeletor(dia, tipo, refeicao))"
                                  Style="cursor:pointer; height:100%; min-height:70px; border-radius:8px; border:1px dashed var(--mud-palette-lines-default); background:transparent; display:flex; align-items:center; justify-content:center;"
                                  Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.Add"
                                     Style="color:var(--mud-palette-text-disabled);" Size="Size.Small" />
                        </MudPaper>
                    }
                </div>
            }
        }
    </div>

    @* ── Ações da semana ─────────────────────────────────────────── *@
    @if (!Mural.Ativo)
    {
        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ContentCopy"
                       OnClick="CopiarSemana">
                @L["Cardapio_CopiarSemana"]
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.BookmarkAdd"
                       OnClick="SalvarComoModelo">
                @L["Cardapio_SalvarModelo"]
            </MudButton>
        </MudStack>
    }
}

@code {
    [Parameter] public string? DataStr { get; set; }

    [Inject] ICardapioService CardapioService { get; set; } = null!;
    [Inject] IModeloSemanaService ModeloService { get; set; } = null!;
    [Inject] IConfiguracaoFamiliaService ConfigService { get; set; } = null!;
    [Inject] IDialogService Dialog { get; set; } = null!;
    [Inject] ISnackbar Snackbar { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;
    [Inject] IJSRuntime JS { get; set; } = null!;

    private DateOnly _dataInicio;
    private DateOnly _dataFim;
    private CardapioSemanaDTO? _cardapio;
    private bool _carregando = true;

    private TipoRefeicao[] _tiposAtivos = [TipoRefeicao.Almoco]; // fallback até carregar a config

    private record DiaInfo(DiaSemana DiaSemana, string NomeCurto, DateOnly Data);
    private List<DiaInfo> _dias = [];

    protected override async Task OnParametersSetAsync()
    {
        await CarregarTiposAtivosAsync();

        _dataInicio = DataStr is not null && DateOnly.TryParse(DataStr, out var d)
            ? d
            : SegundaDeHoje();

        _dataFim = _dataInicio.AddDays(6);
        _dias = Enumerable.Range(0, 7)
            .Select(i =>
            {
                var data = _dataInicio.AddDays(i);
                var diaSemana = (DiaSemana)(i + 1);
                var nome = diaSemana switch
                {
                    DiaSemana.Segunda => "Seg",
                    DiaSemana.Terca   => "Ter",
                    DiaSemana.Quarta  => "Qua",
                    DiaSemana.Quinta  => "Qui",
                    DiaSemana.Sexta   => "Sex",
                    DiaSemana.Sabado  => "Sáb",
                    DiaSemana.Domingo => "Dom",
                    _                  => diaSemana.ToString(),
                };
                return new DiaInfo(diaSemana, nome, data);
            })
            .ToList();

        await CarregarSemanaAsync();
    }

    private async Task CarregarTiposAtivosAsync()
    {
        var cfg = await ConfigService.ObterAsync();
        var tipos = cfg.TiposRefeicaoAtivos
            .Select(t => Enum.TryParse<TipoRefeicao>(t, out var tipo) ? tipo : (TipoRefeicao?)null)
            .Where(t => t.HasValue)
            .Select(t => t!.Value)
            .OrderBy(t => (int)t) // ordem cronológica do dia: Café → Almoço → Lanche → Jantar → Ceia
            .ToArray();

        if (tipos.Length > 0)
            _tiposAtivos = tipos;
    }

    private async Task CarregarSemanaAsync()
    {
        _carregando = true;
        var r = await CardapioService.ObterOuCriarSemanaAsync(_dataInicio);
        _cardapio = r.Sucesso ? r.Valor : null;
        if (!r.Sucesso)
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
        _carregando = false;
    }

    private RefeicaoDiaDTO? ObterRefeicao(DiaSemana dia, TipoRefeicao tipo)
        => _cardapio?.Refeicoes.FirstOrDefault(r => r.DiaSemana == dia && r.TipoRefeicao == tipo);

    private async Task AbrirSeletor(DiaInfo dia, TipoRefeicao tipo, RefeicaoDiaDTO? refeicao)
    {
        if (Mural.Ativo) return; // somente-leitura no Modo Mural

        var parameters = new DialogParameters<SeletorReceita>
        {
            { x => x.DiaSemana,     dia.DiaSemana },
            { x => x.TipoRefeicao,  tipo },
            { x => x.ReceitaIdAtual, refeicao?.ReceitaId },
            { x => x.PorcoesAtual,  refeicao?.PorcoesDesejadas ?? 4 },
        };

        var dialog = await Dialog.ShowAsync<SeletorReceita>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var (receitaId, porcoes) = ((int?, int))result.Data!;

        var cmd = new DefinirRefeicaoCommand
        {
            DataInicio       = _dataInicio,
            DiaSemana        = dia.DiaSemana,
            TipoRefeicao     = tipo,
            ReceitaId        = receitaId,
            PorcoesDesejadas = receitaId.HasValue ? porcoes : null,
        };

        var r = await CardapioService.DefinirRefeicaoAsync(cmd);
        if (r.Sucesso)
            await CarregarSemanaAsync();
        else
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
    }

    private void SemanaAnterior() =>
        Nav.NavigateTo($"/cardapio/{_dataInicio.AddDays(-7):yyyy-MM-dd}");

    private void ProximaSemana() =>
        Nav.NavigateTo($"/cardapio/{_dataInicio.AddDays(7):yyyy-MM-dd}");

    private void IrParaHoje() =>
        Nav.NavigateTo($"/cardapio/{SegundaDeHoje():yyyy-MM-dd}");

    private async Task CopiarSemana()
    {
        var destino = _dataInicio.AddDays(7);
        var r = await CardapioService.CopiarSemanaAsync(_dataInicio, destino);
        if (r.Sucesso)
        {
            Snackbar.Add($"Semana copiada para {destino:dd/MM}!", Severity.Success);
            Nav.NavigateTo($"/cardapio/{destino:yyyy-MM-dd}");
        }
        else
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
    }

    private async Task SalvarComoModelo()
    {
        var result = await JS.InvokeAsync<string?>("prompt",
            "Nome do modelo:", "Minha semana favorita");

        if (string.IsNullOrWhiteSpace(result)) return;

        var r = await ModeloService.SalvarPlanejamentoComoModeloAsync(_dataInicio, result);
        if (r.Sucesso)
            Snackbar.Add("Modelo salvo!", Severity.Success);
        else
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
    }

    private static DateOnly SegundaDeHoje()
    {
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        var diasAteSegunda = ((int)hoje.DayOfWeek - 1 + 7) % 7;
        return hoje.AddDays(-diasAteSegunda);
    }

    private static string NomeTipo(TipoRefeicao t) => t switch
    {
        TipoRefeicao.CafeManha => "Café",
        TipoRefeicao.Almoco    => "Almoço",
        TipoRefeicao.Lanche    => "Lanche",
        TipoRefeicao.Jantar    => "Jantar",
        TipoRefeicao.Ceia      => "Ceia",
        _                      => t.ToString(),
    };
}
