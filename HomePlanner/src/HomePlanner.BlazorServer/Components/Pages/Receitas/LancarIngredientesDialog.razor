@* Diálogo: parseia um texto livre de ingredientes e lança como linhas estruturadas *@
@using Application.HomePlanner.Helpers
@using Domain.HomePlanner.Models.Enums
@inject IImportadorReceitaService Importador
@inject IIngredienteService IngService
@inject ICotaImportacaoService Cota
@inject PublicLanguageService Lang
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Lanc_Titulo"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @L["Lanc_Ajuda"]
            
            
            
        </MudText>

        <MudTextField @bind-Value="_texto" Label="@L["Lanc_TextoLabel"]"
                      Lines="6" AutoGrow="true" Variant="Variant.Outlined" Class="mb-2" />

        <MudCheckBox @bind-Value="_traduzir" Color="Color.Primary" Dense="true" Class="mb-2"
                     Label="@L["Lanc_Traduzir", IdiomaLabel]" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
            @L["Lanc_TraduzirAjuda"]
        </MudText>

        <MudButton StartIcon="@Icons.Material.Filled.AutoFixHigh" Variant="Variant.Outlined"
                   Color="Color.Primary" OnClick="Analisar" Class="mb-3" Disabled="_analisando">
            @(_analisando ? L["Lanc_Analisando"] : L["Lanc_Analisar"])
        </MudButton>

        @if (_analisando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else if (_linhas.Count > 0)
        {
            <MudDivider Class="mb-3" />
            <div class="d-flex justify-space-between align-center mb-2 flex-wrap">
                <MudText Typo="Typo.subtitle2">
                    @L["Lanc_Resumo", _linhas.Count, _linhas.Count(l => l.Selecionado is null)]
                </MudText>
                <MudToggleGroup T="SistemaMedida" Value="_sistema" ValueChanged="TrocarSistema"
                                Size="Size.Small" Color="Color.Primary" CheckMark="true">
                    <MudToggleItem Value="SistemaMedida.Metrico" Text="@L["Medida_Metrico"]" />
                    <MudToggleItem Value="SistemaMedida.Imperial" Text="@L["Medida_Imperial"]" />
                </MudToggleGroup>
            </div>

            @foreach (var linha in _linhas)
            {
                <MudPaper Class="pa-2 mb-2" Elevation="0"
                          Style="background:var(--mud-palette-background-gray); border-radius:8px; border:1px solid var(--mud-palette-lines-default);">
                    <MudGrid Spacing="2" Class="align-center">
                        <MudItem xs="6" md="2">
                            <MudNumericField @bind-Value="linha.Quantidade" Label="@L["Ing_Qtde"]" Min="0m"
                                             Format="G" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudSelect T="int" @bind-Value="linha.UnidadeMedidaId" Label="@L["Ing_Unidade"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var u in Unidades)
                                {
                                    <MudSelectItem Value="@u.Id">@L.AbrevUnidade(u.Codigo)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField Value="linha.Nome"
                                          ValueChanged="@((string v) => AtualizarNome(linha, v))"
                                          Immediate="false" Label="@L["Lanc_NomeIngrediente"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="10" md="2">
                            <MudTextField @bind-Value="linha.Observacao" Label="@L["Lanc_ObsPreparo"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" md="1">
                            @if (linha.Selecionado is null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.AddCircleOutline">@L["Lanc_Novo"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.CheckCircle">@L["Lanc_Existente"]</MudChip>
                            }
                        </MudItem>
                        <MudItem xs="4" md="1">
                            <MudCheckBox @bind-Value="linha.Opcional" Label="@L["Ing_Opcional"]" Size="Size.Small" />
                        </MudItem>
                        <MudItem xs="2" md="1" Class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                           Size="Size.Small" OnClick="@(() => _linhas.Remove(linha))" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        }
        else if (_analisou)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["Receita_NenhumIngredienteTexto"]
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Btn_Cancelar"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aplicar"
                   Disabled="@(_linhas.Count == 0 || _aplicando)">
            @(_aplicando ? L["Lanc_Lancando"] : L["Lanc_LancarN", _linhas.Count])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string TextoInicial { get; set; } = string.Empty;
    [Parameter] public List<UnidadeMedidaListaDTO> Unidades { get; set; } = [];

    /// <summary>Já analisa o texto ao abrir (vindo do "Organizar com IA" ou de uma importação).</summary>
    [Parameter] public bool AnalisarAoAbrir { get; set; }

    private string _texto = string.Empty;
    private bool _analisou;
    private bool _analisando;
    private bool _aplicando;
    private bool _traduzir;
    private SistemaMedida _sistema = SistemaMedida.Metrico;
    private readonly List<LinhaPreview> _linhas = [];

    private string IdiomaLabel => Lang.Lang switch
    {
        "en" => "English",
        "es" => "español",
        "fr" => "français",
        _    => "português",
    };

    protected override void OnInitialized() => _texto = TextoInicial;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AnalisarAoAbrir && !string.IsNullOrWhiteSpace(_texto))
        {
            _analisando = true;
            StateHasChanged(); // mostra o progresso — OnAfterRender não re-renderiza sozinho
            await Analisar();
            StateHasChanged();
        }
    }

    private async Task Analisar()
    {
        _analisando = true;
        try { await AnalisarInterno(); }
        finally { _analisando = false; }
    }

    private async Task AnalisarInterno()
    {
        _analisou = true;
        _linhas.Clear();

        var throttle = await Cota.VerificarThrottleIAAsync();
        if (!throttle.Sucesso)
        {
            Snackbar.Add(L.Traduzir(throttle.Erros), Severity.Warning);
            return;
        }

        var idioma = _traduzir ? Lang.Lang : null;
        foreach (var p in await Importador.ParsearTextoAsync(_texto, idioma))
        {
            var linha = new LinhaPreview
            {
                Quantidade      = p.Quantidade,
                UnidadeMedidaId = ResolverUnidade(p.CodigoUnidade),
                Nome            = p.NomeIngrediente,
                Observacao      = p.Preparo,
                Opcional        = p.Opcional,
            };
            linha.Selecionado = await ResolverIngredienteExistente(linha.Nome);
            _linhas.Add(linha);
        }
    }

    // Alterna métrico/imperial: converte qtde+unidade de cada linha (mesma dimensão).
    private void TrocarSistema(SistemaMedida novo)
    {
        if (novo == _sistema) return;
        _sistema = novo;
        foreach (var l in _linhas)
        {
            if (l.Quantidade is not decimal q || l.UnidadeMedidaId == 0) continue;
            var (nq, nu) = ConversorSistemaMedida.Converter(q, l.UnidadeMedidaId, _sistema, Unidades);
            l.Quantidade = nq;
            l.UnidadeMedidaId = nu;
        }
    }

    // Fallback para "un" (não "g") quando o parser não detectou unidade.
    private int ResolverUnidade(string? codigo)
    {
        var alvo = string.IsNullOrWhiteSpace(codigo) ? "un" : codigo;
        var u = Unidades.FirstOrDefault(x =>
            string.Equals(x.Codigo, alvo, StringComparison.OrdinalIgnoreCase));
        return (u ?? Unidades.FirstOrDefault())?.Id ?? 0;
    }

    private async Task<IngredienteListaDTO?> ResolverIngredienteExistente(string nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return null;
        var candidatos = await IngService.BuscarAutoCompleteAsync(nome, 5);
        var alvo = TextoHelper.NormalizarNome(nome);
        return candidatos.FirstOrDefault(c => TextoHelper.NormalizarNome(c.Nome) == alvo);
    }

    // Ao editar o nome, redetecta se já existe no cadastro (reaproveita unidade padrão).
    private async Task AtualizarNome(LinhaPreview linha, string nome)
    {
        linha.Nome = nome;
        linha.Selecionado = await ResolverIngredienteExistente(nome);
        if (linha.Selecionado?.UnidadeMedidaPadraoId is int uid)
            linha.UnidadeMedidaId = uid;
    }

    private async Task Aplicar()
    {
        _aplicando = true;
        var resultado = new List<IngredienteParseadoDTO>();

        foreach (var l in _linhas)
        {
            var (ingredienteId, nome) = await ResolverParaLancamento(l);
            if (ingredienteId == 0) continue;

            resultado.Add(new IngredienteParseadoDTO
            {
                IngredienteId   = ingredienteId,
                NomeIngrediente = nome,
                Quantidade      = l.Quantidade ?? 0,
                UnidadeMedidaId = l.UnidadeMedidaId,
                Observacao      = string.IsNullOrWhiteSpace(l.Observacao) ? null : l.Observacao.Trim(),
                Opcional        = l.Opcional,
            });
        }

        _aplicando = false;

        if (resultado.Count == 0)
        {
            Snackbar.Add(L["Lanc_NenhumLancado"], Severity.Warning);
            return;
        }
        MudDialog.Close(DialogResult.Ok(new LancamentoIngredientesDTO
        {
            Ingredientes   = resultado,
            IdiomaTraducao = _traduzir ? Lang.Lang : null,
        }));
    }

    // Retorna o id do ingrediente (existente ou recém-criado) e seu nome; 0 se falhar.
    private async Task<(int Id, string Nome)> ResolverParaLancamento(LinhaPreview l)
    {
        if (l.Selecionado is not null)
            return (l.Selecionado.Id, l.Selecionado.Nome);

        var nomeNovo = Capitalizar((l.Nome ?? string.Empty).Trim());
        if (string.IsNullOrWhiteSpace(nomeNovo)) return (0, string.Empty);

        var r = await IngService.SalvarAsync(new IngredientePersistenciaDTO
        {
            Nome                  = nomeNovo,
            UnidadeMedidaPadraoId = l.UnidadeMedidaId == 0 ? null : l.UnidadeMedidaId,
        });

        if (r.Sucesso) return (r.Valor, nomeNovo);

        // Falha provável: nome já existente — tenta reaproveitar.
        var existente = await ResolverIngredienteExistente(nomeNovo);
        if (existente is not null) return (existente.Id, existente.Nome);

        Snackbar.Add(L["Lanc_FalhaCriar", nomeNovo, L.Traduzir(r.Erros)], Severity.Warning);
        return (0, string.Empty);
    }

    private static string Capitalizar(string s)
        => string.IsNullOrWhiteSpace(s) ? s : char.ToUpper(s[0]) + s[1..];

    private class LinhaPreview
    {
        public decimal? Quantidade { get; set; }
        public int UnidadeMedidaId { get; set; }
        public IngredienteListaDTO? Selecionado { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string? Observacao { get; set; }
        public bool Opcional { get; set; }
    }
}
