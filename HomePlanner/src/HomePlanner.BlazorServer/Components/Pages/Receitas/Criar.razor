@page "/receitas/criar"
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> L

<PageTitle>Nova Receita</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

<MudText Typo="Typo.h5" GutterBottom="true"
         Style="font-family:'Fraunces',serif; font-weight:300;">
    Nova receita
</MudText>

<ReceitaForm Dto="_dto" Unidades="_unidades"
             BuscarIngredientes="BuscarIngredientes"
             Salvando="_salvando"
             OnSalvar="SalvarAsync"
             OnCancelar='@(() => Nav.NavigateTo("/receitas"))' />

@code {
    [Inject] IReceitaService Service { get; set; } = null!;
    [Inject] IIngredienteService IngService { get; set; } = null!;
    [Inject] IUnidadeMedidaRepository UnidadeRepo { get; set; } = null!;
    [Inject] ISnackbar Snackbar { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;

    private readonly ReceitaPersistenciaDTO _dto = new();
    private List<UnidadeMedidaListaDTO> _unidades = [];
    private bool _salvando;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Receitas", "/receitas"),
        new("Nova receita", null, disabled: true),
    ];

    protected override async Task OnInitializedAsync()
        => _unidades = (await UnidadeRepo.ListarAtivasAsync()).ToList();

    private async Task<IEnumerable<IngredienteListaDTO>> BuscarIngredientes(string texto, CancellationToken ct)
        => await IngService.BuscarAutoCompleteAsync(texto, 10, ct);

    private async Task SalvarAsync()
    {
        _salvando = true;
        try
        {
            var r = await Service.SalvarAsync(_dto);
            if (r.Sucesso)
            {
                Snackbar.Add("Receita criada com sucesso!", Severity.Success);
                Nav.NavigateTo("/receitas");
            }
            else
                Snackbar.Add(L.Traduzir(r.Erros), Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar a receita: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }
}
