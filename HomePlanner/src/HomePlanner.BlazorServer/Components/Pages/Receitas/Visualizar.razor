@page "/receitas/{Id:int}"
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_dto?.Nome ?? L["Receita_Singular"])</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 pa-0" />

@if (_carregando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_dto is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween"
              Wrap="Wrap.Wrap" Spacing="2" Class="mb-4">
        <MudText Typo="Typo.h4" Style="font-family:'Fraunces',serif; font-weight:300;">
            @_dto.Nome
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="@UrlVoltar">
                @L["Btn_Voltar"]
            </MudButton>
            @if (_podeGerenciar)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/receitas/editar/{_dto.Id}")">
                    @L["Btn_Editar"]
                </MudButton>
            }
        </MudStack>
    </MudStack>

    <MudGrid Spacing="4">
        @if (!string.IsNullOrWhiteSpace(_dto.ImagemSrc))
        {
            <MudItem xs="12" md="5">
                <MudImage Src="@_dto.ImagemSrc" Alt="@_dto.Nome" Fluid="true"
                          ObjectFit="ObjectFit.Cover"
                          Style="width:100%; max-height:320px; border-radius:10px;" />
            </MudItem>
        }

        <MudItem xs="12" md="@(string.IsNullOrWhiteSpace(_dto.ImagemSrc) ? 12 : 7)">
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-4">
                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                         Icon="@Icons.Material.Filled.People">
                    @L["Ia_NPorcoes", _dto.NumeroPorcoesBase]
                </MudChip>
                @if (_dto.TempoPreparoMinutos.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default"
                             Icon="@Icons.Material.Filled.Timer">
                        @L["Ia_NMin", _dto.TempoPreparoMinutos]
                    </MudChip>
                }
                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                         Icon="@Icons.Material.Filled.List">
                    @L["Receita_NIngr", _dto.Ingredientes.Count]
                </MudChip>
                @if (_dto.EhComposto)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                             Icon="@Icons.Material.Filled.Bolt">
                        @L["Receita_NComponentes", _dto.Componentes.Count]
                    </MudChip>
                }
            </MudStack>

            @if (_dto.EhComposto)
            {
                <MudText Typo="Typo.h6" GutterBottom="true">@L["App_Componentes"]</MudText>
                <MudList T="string" Dense="true" Class="mb-3">
                    @foreach (var c in _dto.Componentes.OrderBy(x => x.Ordem))
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Restaurant"
                                     IconSize="Size.Small" Href="@($"/receitas/{c.ComponenteId}")">
                            <MudText Typo="Typo.body2">
                                <strong>@c.Nome</strong>
                                <MudText Component="@("span")" Typo="Typo.body2" Color="Color.Secondary">
                                    — @L["Ia_NPorcoes", c.PorcoesDesejadas]
                                </MudText>
                            </MudText>
                        </MudListItem>
                    }
                </MudList>

                <MudText Typo="Typo.h6" GutterBottom="true">@L["Receita_IngredientesPratoCompleto"]</MudText>
                <MudList T="string" Dense="true">
                    @foreach (var i in _dto.IngredientesExpandidos)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.FiberManualRecord"
                                     IconSize="Size.Small">
                            <MudText Typo="Typo.body2">
                                <strong>@L.FormatarQuantidade(i.Quantidade, i.CodigoUnidade)</strong>
                                @i.NomeIngrediente
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.h6" GutterBottom="true">@L["Ing_Label"]</MudText>
                @if (_dto.Ingredientes.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["App_SemIngredientesCad"]
                    </MudText>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var i in _dto.Ingredientes.OrderBy(x => x.Ordem))
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.FiberManualRecord"
                                         IconSize="Size.Small">
                                <MudText Typo="Typo.body2">
                                    <strong>@L.FormatarQuantidade(i.Quantidade, i.CodigoUnidade)</strong>
                                    @i.NomeIngrediente
                                    @if (!string.IsNullOrWhiteSpace(i.Observacao))
                                    {
                                        <MudText Component="@("span")" Typo="Typo.body2" Color="Color.Secondary">
                                            — @i.Observacao
                                        </MudText>
                                    }
                                    @if (i.Opcional)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                                 Variant="Variant.Text" Class="ml-1">@L["Receita_Opcional"]</MudChip>
                                    }
                                </MudText>
                            </MudListItem>
                        }
                    </MudList>
                }
            }
        </MudItem>
    </MudGrid>

    @* Texto livre dos ingredientes: só enquanto não foram lançados (senão repetiria a lista acima). *@
    @if (!string.IsNullOrWhiteSpace(_dto.IngredientesTexto) && _dto.Ingredientes.Count == 0 && !_dto.EhComposto)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" GutterBottom="true">@L["Receita_IngredientesTextoLabel"]</MudText>
        <MudText Typo="Typo.body1" Style="white-space:pre-wrap; overflow-wrap:anywhere;">@_dto.IngredientesTexto</MudText>
    }

    @if (!string.IsNullOrWhiteSpace(_dto.ModoPreparo)
         || _dto.Componentes.Any(c => !string.IsNullOrWhiteSpace(c.ModoPreparo)))
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" GutterBottom="true">@L["Receita_ModoPreparoLabel"]</MudText>
        @if (!string.IsNullOrWhiteSpace(_dto.ModoPreparo))
        {
            <MudText Typo="Typo.body1" Style="white-space:pre-wrap; overflow-wrap:anywhere;">@_dto.ModoPreparo</MudText>
        }
        @foreach (var c in _dto.Componentes
            .Where(c => !string.IsNullOrWhiteSpace(c.ModoPreparo)).OrderBy(c => c.Ordem))
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">@c.Nome</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary"
                     Style="white-space:pre-wrap; overflow-wrap:anywhere;">@c.ModoPreparo</MudText>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_dto.Observacoes))
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" GutterBottom="true">@L["Receita_ObservacoesLabel"]</MudText>
        <MudText Typo="Typo.body1" Style="white-space:pre-wrap; overflow-wrap:anywhere;">@_dto.Observacoes</MudText>
    }

    @if (!string.IsNullOrWhiteSpace(_dto.UrlOrigem))
    {
        <MudDivider Class="my-4" />
        <MudButton Href="@_dto.UrlOrigem" Target="_blank"
                   Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Link" Class="pa-0">
            @L["Receita_Original"]
        </MudButton>
    }
}
else
{
    <MudAlert Severity="Severity.Error">@L["Receita_NaoEncontrada"]</MudAlert>
}

@code {
    [Parameter] public int Id { get; set; }

    // Origem da navegação (ex.: o cardápio da semana); só aceita caminho local.
    [SupplyParameterFromQuery(Name = "voltar")] public string? Voltar { get; set; }

    private string UrlVoltar =>
        Voltar is { Length: > 1 } v && v.StartsWith('/') && !v.StartsWith("//") && !v.StartsWith("/\\")
            ? v
            : "/receitas";

    [Inject] IReceitaService Service { get; set; } = null!;

    private ReceitaDetalheDTO? _dto;
    private List<BreadcrumbItem> _breadcrumbs = [];
    private bool _carregando = true;
    private bool _podeGerenciar;

    protected override async Task OnInitializedAsync()
    {
        _podeGerenciar = await Service.PodeGerenciarAsync();
        var r = await Service.ObterAsync(Id);
        if (r.Sucesso && r.Valor is not null)
        {
            _dto = r.Valor;
            _breadcrumbs =
            [
                new(L["Receita_Titulo"], "/receitas"),
                new(_dto.Nome, null, disabled: true),
            ];
        }
        _carregando = false;
    }

    private static string FormatarQuantidade(decimal valor)
        => valor == Math.Truncate(valor)
            ? valor.ToString("0")
            : valor.ToString("0.##");
}
