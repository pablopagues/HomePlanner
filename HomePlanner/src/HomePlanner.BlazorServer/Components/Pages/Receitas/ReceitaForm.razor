@* Componente de formulário compartilhado entre Criar e Editar *@
@using Application.HomePlanner.Helpers
@using Domain.HomePlanner.Models.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IDialogService DialogService
@inject IReceitaService ReceitaService
@inject IImagemReceitaProcessor ImagemProcessor
@inject ITradutorReceitaIA Tradutor
@inject ICotaImportacaoService Cota
@inject IImportadorReceitaService Importador
@inject IAssistenteReceitaIA Assistente
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<MudGrid Spacing="3">
    <MudItem xs="12" md="7">
        <MudTextField @bind-Value="Dto.Nome" Label="@L["Receita_NomeLabel"]" Required="true"
                      Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="6" md="2">
        <MudNumericField @bind-Value="Dto.NumeroPorcoesBase" Label="@L["Ia_Porcoes"]" Min="1"
                         Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MudNumericField @bind-Value="Dto.TempoPreparoMinutos" Label="@L["Receita_TempoLabel"]"
                         Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12">
        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Receita_Foto"]</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap" Class="mb-2">
            @if (PreviewSrc is not null)
            {
                <MudImage Src="@PreviewSrc" Alt="@L["Receita_Foto"]" ObjectFit="ObjectFit.Cover"
                          Width="120" Height="120" Style="border-radius:10px;" />
            }
            else
            {
                <MudPaper Class="d-flex align-center justify-center"
                          Style="width:120px; height:120px; border-radius:10px; background:var(--mud-palette-background-gray);"
                          Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Secondary" Size="Size.Large" />
                </MudPaper>
            }
            <MudStack Spacing="2">
                <MudFileUpload T="IBrowserFile" FilesChanged="OnFotoSelecionadaAsync"
                               Accept="image/png,image/jpeg,image/webp" MaximumFileCount="1">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.PhotoCamera" Disabled="_enviandoFoto">
                            @(PreviewSrc is null ? L["Receita_EnviarFoto"] : L["Receita_TrocarFoto"])
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (PreviewSrc is not null)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="RemoverFoto" Disabled="_enviandoFoto">
                        @L["Receita_RemoverFoto"]
                    </MudButton>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["Receita_FotoAjuda"]
                </MudText>
            </MudStack>
        </MudStack>
        <MudTextField @bind-Value="Dto.UrlImagem" Label="@L["Receita_UrlImagemLabel"]"
                      Variant="Variant.Outlined" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Link"
                      HelperText="@L["Receita_UrlImagemAjuda"]" />
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="Dto.IngredientesTexto" Label="@L["Receita_IngredientesTextoLabel"]"
                      Lines="3" AutoGrow="true" Variant="Variant.Outlined" />
        @if (Assistente.Habilitado)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                <MudButton StartIcon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small"
                           Variant="Variant.Outlined" Color="Color.Secondary"
                           OnClick="OrganizarComIAAsync"
                           Disabled="@(_organizando || string.IsNullOrWhiteSpace(Dto.IngredientesTexto))">
                    @(_organizando ? L["Ia_Organizando"] : L["Ia_Organizar"])
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["Receita_OrganizarAjuda"]
                </MudText>
            </MudStack>
        }
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="Dto.ModoPreparo" Label="@L["Receita_ModoPreparoLabel"]"
                      Lines="6" AutoGrow="true" Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="Dto.Observacoes" Label="@L["Receita_ObservacoesLabel"]"
                      Lines="2" AutoGrow="true" Variant="Variant.Outlined" />
    </MudItem>
</MudGrid>

<MudDivider Class="my-4" />

@* ── Componentes (outras receitas que compõem este prato) ─────────────────── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h6">@L["Receita_ComponentesTitulo"]</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @L["Receita_ComponentesAjuda"]
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2">
        <MudButton StartIcon="@Icons.Material.Filled.Bolt" Size="Size.Small"
                   Variant="Variant.Text" Color="Color.Secondary"
                   OnClick="CriarComponenteRapido">
            @L["Receita_CriarComponente"]
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                   Variant="Variant.Outlined" Color="Color.Primary"
                   OnClick="AdicionarComponente">
            @L["Btn_Adicionar"]
        </MudButton>
    </MudStack>
</MudStack>

@foreach (var comp in _componentes)
{
    <MudPaper Class="pa-3 mb-2" Elevation="0"
              Style="background:var(--mud-palette-background-gray); border-radius:8px; border:1px solid var(--mud-palette-lines-default);">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" md="7">
                <MudAutocomplete T="ReceitaListaDTO?" Label="@L["Receita_ComponenteLabel"]"
                                 Value="comp.Selecionado"
                                 Text="@comp.Texto"
                                 TextChanged="@(t => comp.Texto = t)"
                                 CoerceText="false"
                                 SearchFunc="BuscarReceitas"
                                 ToStringFunc="@(r => r?.Nome ?? string.Empty)"
                                 ValueChanged="@(v => AtualizarComponente(comp, v))"
                                 MinCharacters="0" ResetValueOnEmptyText="false"
                                 Clearable="true" OpenOnFocus="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="8" md="3">
                <MudNumericField Value="comp.Dto.PorcoesDesejadas"
                                 ValueChanged="@((int v) => { comp.Dto.PorcoesDesejadas = v; })"
                                 Label="@L["Ia_Porcoes"]" Min="1"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="4" md="2" Class="d-flex justify-end">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                               Size="Size.Small" OnClick="@(() => RemoverComponente(comp))" />
            </MudItem>
        </MudGrid>
    </MudPaper>
}
@if (_componentes.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        @L["Receita_SemComponentes"]
    </MudText>
}

<MudDivider Class="my-4" />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h6">@L["Receita_IngredientesProprios"]</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_linhas.Count > 0)
        {
            <MudToggleGroup T="SistemaMedida" Value="_sistema" ValueChanged="TrocarSistema"
                            Size="Size.Small" Color="Color.Primary" CheckMark="true">
                <MudToggleItem Value="SistemaMedida.Metrico" Text="@L["Medida_Metrico"]" />
                <MudToggleItem Value="SistemaMedida.Imperial" Text="@L["Medida_Imperial"]" />
            </MudToggleGroup>
        }
        @if (_linhas.Any(l => l.Selecionada))
        {
            <MudButton StartIcon="@Icons.Material.Filled.CallSplit" Size="Size.Small"
                       Variant="Variant.Text" Color="Color.Secondary"
                       OnClick="ExtrairComponente">
                @L["Receita_ExtrairComponente"]
            </MudButton>
        }
        <MudButton StartIcon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Small"
                   Variant="Variant.Text" Color="Color.Secondary"
                   OnClick="@(() => AbrirLancarIngredientes())">
            @L["Receita_LancarTexto"]
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                   Variant="Variant.Outlined" Color="Color.Primary"
                   OnClick="AdicionarIngrediente">
            @L["Btn_Adicionar"]
        </MudButton>
    </MudStack>
</MudStack>

@foreach (var (item, idx) in _linhas.Select((l, i) => (l, i)))
{
    <MudPaper Class="pa-3 mb-2" Elevation="0"
              Style="background:var(--mud-palette-background-gray); border-radius:8px; border:1px solid var(--mud-palette-lines-default);">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="2" md="1" Class="d-flex justify-center">
                <MudCheckBox @bind-Value="item.Selecionada" Size="Size.Small"
                             Color="Color.Secondary" />
            </MudItem>
            <MudItem xs="10" md="3">
                <MudAutocomplete T="IngredienteListaDTO?"
                                 Label="@L["Ing_IngredienteLabel"]"
                                 Value="item.Selecionado"
                                 Text="@item.Texto"
                                 TextChanged="@(t => item.Texto = t)"
                                 CoerceText="false"
                                 SearchFunc="BuscarIngredientes"
                                 ToStringFunc="@(i => i?.Nome ?? string.Empty)"
                                 ValueChanged="@(v => AtualizarIngrediente(item, v))"
                                 MinCharacters="2"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="5" md="2">
                <MudNumericField @bind-Value="item.Dto.Quantidade" Label="@L["Ing_Qtde"]"
                                 Min="0m" Format="G"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="7" md="2">
                <MudSelect T="int" @bind-Value="item.Dto.UnidadeMedidaId" Label="@L["Ing_Unidade"]"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var u in Unidades)
                    {
                        <MudSelectItem Value="@u.Id">@L.AbrevUnidade(u.Codigo) — @L.NomeUnidade(u.Codigo, u.Nome)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="9" md="3">
                <MudTextField @bind-Value="item.Dto.Observacao" Label="@L["Ing_Obs"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="2" md="1">
                <MudStack AlignItems="AlignItems.Center">
                    <MudCheckBox @bind-Value="item.Dto.Opcional" Label="@L["Ing_Opcional"]" Size="Size.Small" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                   Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => RemoverIngrediente(item))" />
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_linhas.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @L["Ing_Nenhum"]
    </MudText>
}

@* ── Prévia da compra deste prato (próprios + componentes) ────────────────── *@
<MudDivider Class="my-4" />
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.subtitle1">@L["Receita_PreviaCompra"]</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Size="Size.Small" Variant="Variant.Text"
               OnClick="AtualizarPrevia" Disabled="_carregandoPrevia">
        @L["Receita_AtualizarPrevia"]
    </MudButton>
</MudStack>
@if (_carregandoPrevia)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}
else if (_previa.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        @L["Receita_PreviaVazia"]
    </MudText>
}
else
{
    <MudPaper Class="pa-3 mb-2" Elevation="0"
              Style="background:var(--mud-palette-background-gray); border-radius:8px;">
        <MudGrid Spacing="1">
            @foreach (var p in _previa)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="Typo.body2">
                        <strong>@L.FormatarQuantidade(p.Quantidade, p.CodigoUnidade)</strong> @p.NomeIngrediente
                    </MudText>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
}

<MudDivider Class="my-4" />

<MudStack Row="true" Spacing="2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               OnClick="HandleSalvar" Disabled="Salvando">
        @(Salvando ? L["Btn_Salvando"] : L["Receita_SalvarBtn"])
    </MudButton>
    <MudButton Variant="Variant.Text" OnClick="OnCancelar">@L["Btn_Cancelar"]</MudButton>
</MudStack>

@code {
    [Parameter, EditorRequired] public ReceitaPersistenciaDTO Dto { get; set; } = null!;
    [Parameter, EditorRequired] public List<UnidadeMedidaListaDTO> Unidades { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string, CancellationToken, Task<IEnumerable<IngredienteListaDTO>>> BuscarIngredientes { get; set; } = null!;
    [Parameter] public bool Salvando { get; set; }
    [Parameter] public EventCallback OnSalvar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    /// <summary>
    /// Abre o "Lançar ingredientes" já analisando o texto ao carregar (receita recém
    /// importada/sugerida, ainda sem ingredientes estruturados).
    /// </summary>
    [Parameter] public bool AbrirLancamentoAoIniciar { get; set; }

    private bool _organizando;

    private List<IngredienteLinhaForm> _linhas = [];
    private List<ComponenteLinhaForm> _componentes = [];
    private SistemaMedida _sistema = SistemaMedida.Metrico;

    private List<IngredienteExpandidoDTO> _previa = [];
    private bool _carregandoPrevia;
    private bool _inicializado;

    // Data URI da foto recém-enviada (prévia imediata, antes de salvar).
    private string? _novaFotoPreview;
    private bool _enviandoFoto;

    // Foto a exibir: recém-enviada > foto já gravada (a menos que marcada p/ remoção).
    private string? PreviewSrc =>
        _novaFotoPreview
        ?? (Dto.TemFotoAtual && !Dto.RemoverFoto && Dto.Id > 0
            ? $"/receita/{Dto.Id}/foto?v={(Dto.FotoAtualizadaEm ?? DateTime.UnixEpoch).Ticks}"
            : null);

    // Classe interna para manter estado do autocomplete separado do DTO
    private class IngredienteLinhaForm
    {
        public ReceitaIngredientePersistenciaDTO Dto { get; set; } = new();
        public IngredienteListaDTO? Selecionado { get; set; }
        public string Texto { get; set; } = string.Empty;
        public bool Selecionada { get; set; }
    }

    private class ComponenteLinhaForm
    {
        public ReceitaComponentePersistenciaDTO Dto { get; set; } = new();
        public ReceitaListaDTO? Selecionado { get; set; }
        public string Texto { get; set; } = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_inicializado) return;
        _inicializado = true;

        if (Dto.Ingredientes.Count > 0)
            _linhas = Dto.Ingredientes.Select(CriarLinhaIngrediente).ToList();

        if (Dto.Componentes.Count > 0)
        {
            _componentes = Dto.Componentes.Select(d => new ComponenteLinhaForm
            {
                Dto         = d,
                Texto       = d.NomeComponente,
                Selecionado = new ReceitaListaDTO { Id = d.ReceitaComponenteId, Nome = d.NomeComponente },
            }).ToList();
            await AtualizarPrevia();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AbrirLancamentoAoIniciar
            && _linhas.Count == 0 && !string.IsNullOrWhiteSpace(Dto.IngredientesTexto))
            await AbrirLancarIngredientes(analisarAoAbrir: true);
    }

    // ── Organizar com IA (receita inteira colada no campo de ingredientes) ───
    private async Task OrganizarComIAAsync()
    {
        _organizando = true;
        var r = await Importador.ImportarDeTextoAsync(Dto.IngredientesTexto);
        _organizando = false;

        if (!r.Sucesso || r.Valor is null)
        {
            Snackbar.Add(L.Traduzir(r.Erros), Severity.Warning);
            return;
        }

        var p = r.Valor;
        if (string.IsNullOrWhiteSpace(Dto.Nome)) Dto.Nome = p.Nome;
        if (Dto.Id == 0) Dto.NumeroPorcoesBase = p.NumeroPorcoesBase;
        Dto.TempoPreparoMinutos ??= p.TempoPreparoMinutos;

        // Não sobrescreve um modo de preparo que já foi digitado.
        var preparoMantido = false;
        if (!string.IsNullOrWhiteSpace(p.ModoPreparo))
        {
            if (string.IsNullOrWhiteSpace(Dto.ModoPreparo)) Dto.ModoPreparo = p.ModoPreparo;
            else preparoMantido = true;
        }

        Dto.IngredientesTexto = string.Join("\n", p.IngredientesTexto);
        Dto.ContarImportacaoIA = true;
        StateHasChanged();

        if (preparoMantido)
            Snackbar.Add(L["Receita_PreparoMantido"], Severity.Info);

        if (p.IngredientesTexto.Count > 0)
            await AbrirLancarIngredientes(analisarAoAbrir: true);
        else
            Snackbar.Add(L["Receita_NenhumIngredienteTexto"], Severity.Warning);
    }

    private static IngredienteLinhaForm CriarLinhaIngrediente(ReceitaIngredientePersistenciaDTO d)
        => new()
        {
            Dto         = d,
            Texto       = d.NomeIngrediente ?? string.Empty,
            Selecionado = d.IngredienteId > 0
                ? new IngredienteListaDTO { Id = d.IngredienteId, Nome = d.NomeIngrediente ?? string.Empty }
                : null,
        };

    // ── Foto ─────────────────────────────────────────────────────────────────
    private async Task OnFotoSelecionadaAsync(IBrowserFile? file)
    {
        if (file is null) return;

        if (file.Size > ImagemProcessor.TamanhoMaximoEntradaBytes)
        {
            Snackbar.Add(
                L["Receita_ImagemGrande", ImagemProcessor.TamanhoMaximoEntradaBytes / (1024 * 1024)],
                Severity.Warning);
            return;
        }

        _enviandoFoto = true;
        try
        {
            using var ms = new MemoryStream();
            await using (var stream = file.OpenReadStream(ImagemProcessor.TamanhoMaximoEntradaBytes))
                await stream.CopyToAsync(ms);

            var r = await ImagemProcessor.ProcessarAsync(ms.ToArray(), file.ContentType);
            if (!r.Sucesso || r.Valor is null)
            {
                Snackbar.Add(r.Erros.Count > 0 ? L.Traduzir(r.Erros) : L["Receita_ImagemFalha"], Severity.Error);
                return;
            }

            Dto.FotoConteudo = r.Valor.Conteudo;
            Dto.FotoContentType = r.Valor.ContentType;
            Dto.RemoverFoto = false;
            _novaFotoPreview = $"data:{r.Valor.ContentType};base64,{Convert.ToBase64String(r.Valor.Conteudo)}";
            Snackbar.Add(L["Receita_FotoPronta"], Severity.Success);
        }
        catch (IOException)
        {
            Snackbar.Add(L["Receita_ArquivoIlegivel"], Severity.Warning);
        }
        finally
        {
            _enviandoFoto = false;
        }
    }

    private void RemoverFoto()
    {
        _novaFotoPreview = null;
        Dto.FotoConteudo = null;
        Dto.FotoContentType = null;
        // Se havia foto gravada, marca p/ remoção no save. Se era só uma foto nova
        // ainda não salva, basta ter limpado FotoConteudo acima.
        Dto.RemoverFoto = Dto.TemFotoAtual;
    }

    private void AdicionarIngrediente()
    {
        var novo = new ReceitaIngredientePersistenciaDTO
        {
            Ordem = _linhas.Count,
            UnidadeMedidaId = Unidades.FirstOrDefault()?.Id ?? 0,
        };
        Dto.Ingredientes.Add(novo);
        _linhas.Add(new IngredienteLinhaForm { Dto = novo });
    }

    private async Task AbrirLancarIngredientes(bool analisarAoAbrir = false)
    {
        var parameters = new DialogParameters<LancarIngredientesDialog>
        {
            { x => x.TextoInicial,    Dto.IngredientesTexto ?? string.Empty },
            { x => x.Unidades,        Unidades },
            { x => x.AnalisarAoAbrir, analisarAoAbrir },
        };

        var dialog = await DialogService.ShowAsync<LancarIngredientesDialog>(
            string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled
            || result.Data is not LancamentoIngredientesDTO lancamento) return;

        var novos = lancamento.Ingredientes;
        int adicionados = 0, mesclados = 0;
        foreach (var n in novos)
        {
            // Evita o mesmo ingrediente duas vezes (restrição única na receita):
            // mescla na linha existente — soma se a unidade for igual.
            var existente = _linhas.FirstOrDefault(l => l.Dto.IngredienteId == n.IngredienteId);
            if (existente is not null)
            {
                if (existente.Dto.UnidadeMedidaId == n.UnidadeMedidaId)
                    existente.Dto.Quantidade += n.Quantidade;
                existente.Dto.Observacao = JuntarObs(existente.Dto.Observacao, n.Observacao);
                mesclados++;
                continue;
            }

            var dto = new ReceitaIngredientePersistenciaDTO
            {
                IngredienteId   = n.IngredienteId,
                NomeIngrediente = n.NomeIngrediente,
                Quantidade      = n.Quantidade,
                UnidadeMedidaId = n.UnidadeMedidaId,
                Observacao      = n.Observacao,
                Opcional        = n.Opcional,
                Ordem           = _linhas.Count,
            };
            Dto.Ingredientes.Add(dto);
            _linhas.Add(new IngredienteLinhaForm
            {
                Dto         = dto,
                Texto       = n.NomeIngrediente,
                Selecionado = new IngredienteListaDTO { Id = n.IngredienteId, Nome = n.NomeIngrediente },
            });
            adicionados++;
        }
        RecalcularOrdem();

        Snackbar.Add(
            mesclados > 0
                ? L["Receita_LancadosMesclados", adicionados, mesclados]
                : L["Receita_Lancados", adicionados],
            Severity.Success);

        // Se o usuário pediu tradução, traduz também o texto livre da receita.
        if (lancamento.IdiomaTraducao is string idioma)
            await TraduzirTextoReceitaAsync(idioma);

        await AtualizarPrevia();
        // Pode ter sido aberto de OnAfterRenderAsync, que não re-renderiza sozinho.
        StateHasChanged();
    }

    // Traduz nome + modo de preparo + observações da receita para o idioma escolhido.
    private async Task TraduzirTextoReceitaAsync(string idioma)
    {
        var throttle = await Cota.VerificarThrottleIAAsync();
        if (!throttle.Sucesso)
        {
            Snackbar.Add(L.Traduzir(throttle.Erros), Severity.Warning);
            return;
        }

        var t = await Tradutor.TraduzirAsync(Dto.Nome, Dto.ModoPreparo, Dto.Observacoes, idioma);
        if (t is null)
        {
            Snackbar.Add(L["Receita_TraducaoFalhou"], Severity.Warning);
            return;
        }

        Dto.Nome        = t.Nome ?? Dto.Nome;
        Dto.ModoPreparo = t.ModoPreparo ?? Dto.ModoPreparo;
        Dto.Observacoes = t.Observacoes ?? Dto.Observacoes;
        StateHasChanged();
    }

    private static string? JuntarObs(string? a, string? b)
    {
        var join = string.Join("; ", new[] { a, b }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim())
            .Distinct());
        return string.IsNullOrWhiteSpace(join) ? null : join;
    }

    private void RemoverIngrediente(IngredienteLinhaForm linha)
    {
        Dto.Ingredientes.Remove(linha.Dto);
        _linhas.Remove(linha);
        RecalcularOrdem();
    }

    private void AtualizarIngrediente(IngredienteLinhaForm linha, IngredienteListaDTO? selecionado)
    {
        linha.Selecionado = selecionado;
        linha.Dto.IngredienteId = selecionado?.Id ?? 0;
        linha.Dto.NomeIngrediente = selecionado?.Nome;
        if (selecionado is not null) linha.Texto = selecionado.Nome;
        // Auto-preenche unidade padrão do ingrediente
        if (selecionado?.UnidadeMedidaPadraoId.HasValue == true)
            linha.Dto.UnidadeMedidaId = selecionado.UnidadeMedidaPadraoId.Value;
    }

    private void RecalcularOrdem()
    {
        for (int i = 0; i < _linhas.Count; i++)
            _linhas[i].Dto.Ordem = i;
    }

    // Alterna métrico/imperial: converte qtde+unidade de cada linha (mesma dimensão).
    private void TrocarSistema(SistemaMedida novo)
    {
        if (novo == _sistema) return;
        _sistema = novo;
        foreach (var l in _linhas)
        {
            if (l.Dto.UnidadeMedidaId == 0) continue;
            var (nq, nu) = ConversorSistemaMedida.Converter(
                l.Dto.Quantidade, l.Dto.UnidadeMedidaId, _sistema, Unidades);
            l.Dto.Quantidade = nq;
            l.Dto.UnidadeMedidaId = nu;
        }
    }

    // ── Componentes ────────────────────────────────────────────────────────────

    private async Task<IEnumerable<ReceitaListaDTO>> BuscarReceitas(string texto, CancellationToken ct)
    {
        var excluir = Dto.Id == 0 ? (int?)null : Dto.Id;
        var res = await ReceitaService.BuscarAutoCompleteAsync(texto, 10, excluir, ct);
        var jaUsados = _componentes.Select(c => c.Dto.ReceitaComponenteId).ToHashSet();
        return res.Where(r => !jaUsados.Contains(r.Id));
    }

    private void AdicionarComponente()
    {
        var novo = new ReceitaComponentePersistenciaDTO
        {
            PorcoesDesejadas = Math.Max(1, Dto.NumeroPorcoesBase),
            Ordem            = _componentes.Count,
        };
        Dto.Componentes.Add(novo);
        _componentes.Add(new ComponenteLinhaForm { Dto = novo });
    }

    private async Task AtualizarComponente(ComponenteLinhaForm linha, ReceitaListaDTO? sel)
    {
        if (sel is null)
        {
            linha.Selecionado = null;
            linha.Dto.ReceitaComponenteId = 0;
            linha.Dto.NomeComponente = string.Empty;
            linha.Texto = string.Empty;
            return;
        }
        if (Dto.Id != 0 && sel.Id == Dto.Id)
        {
            Snackbar.Add(L["Receita_ComponenteDeSiMesma"], Severity.Warning);
            return;
        }
        if (_componentes.Any(c => c != linha && c.Dto.ReceitaComponenteId == sel.Id))
        {
            Snackbar.Add(L["Receita_ComponenteDuplicado"], Severity.Warning);
            return;
        }

        linha.Selecionado = sel;
        linha.Texto = sel.Nome;
        linha.Dto.ReceitaComponenteId = sel.Id;
        linha.Dto.NomeComponente = sel.Nome;
        if (linha.Dto.PorcoesDesejadas < 1)
            linha.Dto.PorcoesDesejadas = Math.Max(1, sel.NumeroPorcoesBase);
        await AtualizarPrevia();
    }

    private async Task RemoverComponente(ComponenteLinhaForm linha)
    {
        Dto.Componentes.Remove(linha.Dto);
        _componentes.Remove(linha);
        RecalcularOrdemComponentes();
        await AtualizarPrevia();
    }

    private void RecalcularOrdemComponentes()
    {
        for (int i = 0; i < _componentes.Count; i++)
            _componentes[i].Dto.Ordem = i;
    }

    private void AdicionarComponenteCriado(ComponenteCriado criado)
    {
        if (_componentes.Any(c => c.Dto.ReceitaComponenteId == criado.Id)) return;
        var novo = new ReceitaComponentePersistenciaDTO
        {
            ReceitaComponenteId = criado.Id,
            NomeComponente      = criado.Nome,
            PorcoesDesejadas    = Math.Max(1, criado.Porcoes),
            Ordem               = _componentes.Count,
        };
        Dto.Componentes.Add(novo);
        _componentes.Add(new ComponenteLinhaForm
        {
            Dto         = novo,
            Texto       = criado.Nome,
            Selecionado = new ReceitaListaDTO { Id = criado.Id, Nome = criado.Nome },
        });
    }

    private async Task CriarComponenteRapido()
    {
        var parameters = new DialogParameters<ComponenteRapidoDialog> { { x => x.Unidades, Unidades } };
        var dialog = await DialogService.ShowAsync<ComponenteRapidoDialog>(
            string.Empty, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ComponenteCriado criado) return;

        AdicionarComponenteCriado(criado);
        await AtualizarPrevia();
        Snackbar.Add(L["Receita_ComponenteCriado", criado.Nome], Severity.Success);
    }

    private async Task ExtrairComponente()
    {
        var selecionadas = _linhas.Where(l => l.Selecionada && l.Dto.IngredienteId > 0).ToList();
        if (selecionadas.Count == 0)
        {
            Snackbar.Add(L["Receita_MarqueParaExtrair"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ExtrairComponenteDialog>
        {
            { x => x.Ingredientes,     selecionadas.Select(l => l.Dto).ToList() },
            { x => x.PorcoesSugeridas, Dto.NumeroPorcoesBase },
        };
        var dialog = await DialogService.ShowAsync<ExtrairComponenteDialog>(
            string.Empty, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ComponenteCriado criado) return;

        foreach (var l in selecionadas)
        {
            Dto.Ingredientes.Remove(l.Dto);
            _linhas.Remove(l);
        }
        RecalcularOrdem();
        AdicionarComponenteCriado(criado);
        await AtualizarPrevia();
        Snackbar.Add(L["Receita_ExtraidoComponente", criado.Nome], Severity.Success);
    }

    // ── Prévia ─────────────────────────────────────────────────────────────────

    private async Task AtualizarPrevia()
    {
        _carregandoPrevia = true;
        try
        {
            var deComponentes = await ReceitaService.ExpandirComponentesAsync(Dto.Componentes);
            var proprios = _linhas
                .Where(l => l.Dto.IngredienteId > 0)
                .Select(l => new IngredienteExpandidoDTO
                {
                    IngredienteId   = l.Dto.IngredienteId,
                    NomeIngrediente = l.Selecionado?.Nome ?? string.Empty,
                    Quantidade      = l.Dto.Quantidade,
                    UnidadeMedidaId = l.Dto.UnidadeMedidaId,
                    CodigoUnidade   = UnidadeCodigo(l.Dto.UnidadeMedidaId),
                    NomeUnidade     = UnidadeNome(l.Dto.UnidadeMedidaId),
                });
            _previa = ExpansorReceita.Consolidar(proprios.Concat(deComponentes));
        }
        finally
        {
            _carregandoPrevia = false;
        }
    }

    private string UnidadeCodigo(int id) => Unidades.FirstOrDefault(u => u.Id == id)?.Codigo ?? string.Empty;
    private string UnidadeNome(int id) => Unidades.FirstOrDefault(u => u.Id == id)?.Nome ?? string.Empty;

    private static string FormatarQtd(decimal v)
        => v == Math.Truncate(v) ? v.ToString("0") : v.ToString("0.##");

    private async Task HandleSalvar()
    {
        RecalcularOrdem();
        RecalcularOrdemComponentes();
        await OnSalvar.InvokeAsync();
    }
}
