@inherits LayoutComponentBase
@using HomePlanner.MobileApp.Services
@inject SessaoAtual Sessao
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-bar">
        <button class="menu-btn" @onclick="() => menuAberto = !menuAberto">☰</button>
        <span class="app-titulo">HomePlanner</span>
        <button class="menu-btn" @onclick="Sair" title="@L["Nav_Sair"]">⏻</button>
    </header>

    @if (menuAberto)
    {
        <nav class="menu" @onclick="() => menuAberto = false">
            @foreach (var (rota, rotulo) in Itens)
            {
                <NavLink class="menu-item" href="@rota" Match="NavLinkMatch.All">@rotulo</NavLink>
            }
        </nav>
    }

    <article class="conteudo">
        @Body
    </article>
</div>

@code {
    private bool menuAberto;

    private (string rota, string rotulo)[] Itens =>
    [
        ("/dashboard", $"🏠 {L["Nav_Dashboard"]}"),
        ("/cardapio", $"🍽️ {L["Nav_Cardapio"]}"),
        ("/modelos", $"🗓️ {L["Nav_Modelos"]}"),
        ("/receitas", $"📖 {L["Nav_Receitas"]}"),
        ("/ingredientes", $"🥕 {L["App_Ingredientes"]}"),
        ("/planner", $"✅ {L["Nav_Planner"]}"),
        ("/calendario", $"📆 {L["Nav_Calendario"]}"),
        ("/compras", $"🛒 {L["App_Compras"]}"),
        ("/lojas", $"🏬 {L["App_Lojas"]}"),
        ("/recorrentes", $"🔁 {L["App_Recorrentes"]}"),
        ("/familia", $"👪 {L["Nav_Familia"]}"),
        ("/perfil", $"👤 {L["App_Perfil"]}"),
    ];

    protected override void OnInitialized()
    {
        if (!Sessao.EstaLogado)
            Nav.NavigateTo("/");
    }

    private void Sair()
    {
        Sessao.Sair();
        Nav.NavigateTo("/");
    }
}
