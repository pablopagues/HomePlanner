@page "/feedback"
@using HomePlanner.MobileApp.Services
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<button class="link" style="text-align:left;width:auto" @onclick='() => Nav.NavigateTo("/perfil")'>‹ @L["Btn_Voltar"]</button>
<div class="barra-topo"><h2>@L["Fb_Titulo"]</h2></div>

@if (enviado)
{
    <p class="muted">@L["App_ObrigadoFeedback"]</p>
    <button class="link" @onclick='() => Nav.NavigateTo("/cardapio")'>@L["App_VoltarInicio"]</button>
}
else
{
    <label>@L["Fb_Tipo"]</label>
    <select @bind="_tipo">
        <option value="Sugestao">@L["App_TipoSugestao"]</option>
        <option value="Bug">@L["App_TipoBug"]</option>
        <option value="Elogio">@L["App_TipoElogio"]</option>
        <option value="Outro">@L["App_TipoOutro"]</option>
    </select>

    <label>@L["Fb_Mensagem"]</label>
    <textarea rows="5" @bind="_mensagem" placeholder="@L["App_FeedbackPlaceholder"]"></textarea>

    <button class="btn-acao" @onclick="EnviarAsync" disabled="@ocupado">
        @(ocupado ? L["Fb_Enviando"] : L["Fb_Enviar"])
    </button>
    @if (erro is not null) { <p class="erro">@erro</p> }
}

@code {
    private string _tipo = "Sugestao";
    private string _mensagem = "";
    private bool ocupado, enviado;
    private string? erro;

    private async Task EnviarAsync()
    {
        erro = null;
        if (_mensagem.Trim().Length < 10) { erro = L["Fb_ErroMin"]; return; }

        ocupado = true;
        erro = await Api.EnviarFeedbackAsync(new FeedbackRequest { Tipo = _tipo, Mensagem = _mensagem.Trim() });
        ocupado = false;
        if (erro is null) enviado = true;
    }
}
