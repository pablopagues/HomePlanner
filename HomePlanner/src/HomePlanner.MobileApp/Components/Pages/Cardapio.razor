@page "/cardapio"
@using HomePlanner.MobileApp.Services
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L

<div class="barra-topo">
    <button class="menu-btn" style="color:var(--hp-primary)" @onclick="() => MudarSemana(-7)">‹</button>
    <h2>@_segunda.ToString("dd/MM") – @_segunda.AddDays(6).ToString("dd/MM")</h2>
    <button class="menu-btn" style="color:var(--hp-primary)" @onclick="() => MudarSemana(7)">›</button>
</div>
<button class="link" @onclick="IrParaHoje">@L["App_IrEstaSemana"]</button>

@if (carregando) { <p class="muted">@L["Btn_Carregando"]</p> }
else if (erro is not null) { <p class="erro">@erro</p> }
else
{
    <div class="cardapio-grade">
        <div class="cel cab"></div>
        @foreach (var d in _dias) { <div class="cel cab">@d.curto</div> }

        @foreach (var t in _tipos)
        {
            <div class="cel rot">@t.rotulo</div>
            @foreach (var d in _dias)
            {
                var r = Refeicao(d.chave, t.chave);
                <div class="cel @(r is not null ? "cheia" : "")" style="cursor:pointer"
                     @onclick="() => AbrirSeletor(d.chave, t.chave, r)">
                    @if (r is not null)
                    {
                        @if (r.ReceitaId is int rid && _imgs.TryGetValue(rid, out var img))
                        {
                            <img src="@img" alt="" onerror="this.style.display='none'" style="width:100%;height:34px;object-fit:cover;border-radius:5px;margin-bottom:2px" />
                        }
                        <span>@r.ReceitaNome</span>
                    }
                    else { <span class="muted">+</span> }
                </div>
            }
        }
    </div>
}

@if (_seletorAberto)
{
    <div class="modal-fundo" @onclick="Fechar">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>@RotuloDia(_selDia) · @RotuloTipo(_selTipo)</h3>

            <input placeholder="Buscar receita..." @bind="_busca" @bind:event="oninput" @onkeyup="BuscarAsync" />

            @if (_buscando) { <p class="muted">@L["App_Buscando"]</p> }
            else
            {
                <div style="max-height:220px;overflow-y:auto">
                    @foreach (var rec in _resultados)
                    {
                        <div class="item-check" style="cursor:pointer" @onclick="() => DefinirAsync(rec.Id)">
                            <span>@rec.Nome</span>
                        </div>
                    }
                </div>
            }

            <label>@L["Receita_Porcoes"]</label>
            <input type="number" min="1" @bind="_porcoes" />

            <div class="linha" style="margin-top:.8rem">
                @if (_selReceitaAtual.HasValue)
                {
                    <button class="link" style="color:var(--hp-danger)" @onclick="RemoverAsync">@L["App_RemoverReceita"]</button>
                }
                <button class="link" @onclick="Fechar">@L["Btn_Cancelar"]</button>
            </div>
            @if (_erroModal is not null) { <p class="erro">@_erroModal</p> }
        </div>
    </div>
}

@code {
    private DateOnly _segunda;
    private CardapioSemanaDTO? _cardapio;
    private bool carregando = true;
    private string? erro;
    private readonly Dictionary<int, string> _imgs = new();

    private bool _seletorAberto;
    private string _selDia = "", _selTipo = "";
    private int? _selReceitaAtual;
    private int _porcoes = 4;
    private string _busca = "";
    private List<ReceitaListaDTO> _resultados = new();
    private bool _buscando;
    private string? _erroModal;
    private CancellationTokenSource? _cts;

    private static readonly (string chave, string curto)[] _dias =
    [
        ("Segunda","Seg"),("Terca","Ter"),("Quarta","Qua"),("Quinta","Qui"),
        ("Sexta","Sex"),("Sabado","Sáb"),("Domingo","Dom"),
    ];
    private static readonly (string chave, string rotulo)[] _tipos =
    [
        ("CafeManha","Café"),("Almoco","Almoço"),("Lanche","Lanche"),("Jantar","Jantar"),("Ceia","Ceia"),
    ];

    protected override async Task OnInitializedAsync()
    {
        _segunda = SegundaDe(DateOnly.FromDateTime(DateTime.Today));
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        carregando = true; erro = null; _imgs.Clear();
        var (dados, err) = await Api.ObterCardapioSemanaAsync(_segunda);
        carregando = false;
        if (err is not null) { erro = err; return; }
        _cardapio = dados;
        _ = CarregarImagensAsync(); // popula as miniaturas sem travar a grade
    }

    private async Task CarregarImagensAsync()
    {
        if (_cardapio is null) return;
        var receitas = _cardapio.Refeicoes
            .Where(r => r.ReceitaId.HasValue)
            .GroupBy(r => r.ReceitaId!.Value)
            .Select(g => g.First());

        foreach (var r in receitas)
        {
            var rid = r.ReceitaId!.Value;
            if (_imgs.ContainsKey(rid)) continue;

            string? src = null;
            if (r.ReceitaTemFoto)
                src = await Api.ObterImagemDataUrlAsync($"/api/receitas/{rid}/foto");
            else if (r.ReceitaImagemSrc is not null && r.ReceitaImagemSrc.StartsWith("http"))
                src = r.ReceitaImagemSrc;

            if (src is not null) { _imgs[rid] = src; StateHasChanged(); }
        }
    }

    private RefeicaoDiaDTO? Refeicao(string dia, string tipo)
        => _cardapio?.Refeicoes.FirstOrDefault(r => r.DiaSemana == dia && r.TipoRefeicao == tipo && r.ReceitaId.HasValue);

    private async Task AbrirSeletor(string dia, string tipo, RefeicaoDiaDTO? atual)
    {
        _selDia = dia; _selTipo = tipo;
        _selReceitaAtual = atual?.ReceitaId;
        _porcoes = atual?.PorcoesDesejadas ?? 4;
        _busca = ""; _erroModal = null;
        _seletorAberto = true;
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _buscando = true;
        var (dados, _) = await Api.ListarReceitasAsync(_busca, 1, _cts.Token);
        if (_cts.IsCancellationRequested) return;
        _buscando = false;
        _resultados = dados?.Itens ?? new();
        StateHasChanged();
    }

    private async Task DefinirAsync(int receitaId)
    {
        _erroModal = await Api.DefinirRefeicaoAsync(new DefinirRefeicaoRequest
        {
            DataInicio = _segunda, DiaSemana = _selDia, TipoRefeicao = _selTipo,
            ReceitaId = receitaId, PorcoesDesejadas = _porcoes,
        });
        if (_erroModal is null) { Fechar(); await CarregarAsync(); }
    }

    private async Task RemoverAsync()
    {
        _erroModal = await Api.DefinirRefeicaoAsync(new DefinirRefeicaoRequest
        {
            DataInicio = _segunda, DiaSemana = _selDia, TipoRefeicao = _selTipo, ReceitaId = null,
        });
        if (_erroModal is null) { Fechar(); await CarregarAsync(); }
    }

    private void Fechar() => _seletorAberto = false;

    private async Task MudarSemana(int dias) { _segunda = _segunda.AddDays(dias); await CarregarAsync(); }
    private async Task IrParaHoje() { _segunda = SegundaDe(DateOnly.FromDateTime(DateTime.Today)); await CarregarAsync(); }

    private static string RotuloDia(string c) => _dias.FirstOrDefault(x => x.chave == c).curto;
    private static string RotuloTipo(string c) => _tipos.FirstOrDefault(x => x.chave == c).rotulo;

    private static DateOnly SegundaDe(DateOnly d)
    {
        var diff = ((int)d.DayOfWeek - 1 + 7) % 7;
        return d.AddDays(-diff);
    }
}
