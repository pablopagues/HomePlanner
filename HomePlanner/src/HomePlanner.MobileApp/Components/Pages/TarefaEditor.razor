@page "/tarefa"
@page "/tarefa/{Id:int}"
@using HomePlanner.MobileApp.Services
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<button class="link" style="text-align:left;width:auto" @onclick='() => Nav.NavigateTo("/planner")'>‹ @L["Btn_Voltar"]</button>
<div class="barra-topo"><h2>@(Id.HasValue ? L["Planner_Editar"] : L["Planner_Nova"])</h2></div>

@if (carregando) { <p class="muted">@L["Btn_Carregando"]</p> }
else
{
    <label>@L["Planner_TituloLabel"]</label>
    <input @bind="_dto.Titulo" />

    <label>@L["Planner_DescricaoLabel"]</label>
    <textarea rows="3" @bind="_dto.Descricao"></textarea>

    <div class="campo-linha">
        <div>
            <label>@L["App_Data"]</label>
            <input type="date" @bind="_dto.DataPrevista" />
        </div>
        <div>
            <label>@L["App_Hora"]</label>
            <input type="time" @bind="_dto.HoraInicio" />
        </div>
    </div>

    @* Antecedência do lembrete — só dispara em tarefa com hora. *@
    <label>@L["Planner_AlertaLabel"]</label>
    <select @bind="_antecedencia" disabled="@(!_dto.HoraInicio.HasValue)">
        @foreach (var min in OpcoesAntecedencia)
        {
            <option value="@min">@TextoAntecedencia(min)</option>
        }
    </select>
    @if (!_dto.HoraInicio.HasValue)
    {
        <div class="muted">@L["Alerta_PrecisaHora"]</div>
    }

    <label>@L["Planner_ResponsavelLabel"]</label>
    <select @bind="_dto.ResponsavelUsuarioId">
        <option value="">@L["App_Ninguem"]</option>
        @foreach (var m in _membros)
        {
            <option value="@m.UsuarioId">@m.Nome</option>
        }
    </select>

    <label style="display:flex;align-items:center;gap:.5rem;margin-top:.8rem">
        <input type="checkbox" style="width:18px;height:18px" @bind="_dto.NotificarResponsaveis" />
        @L["App_NotificarResponsavel"]
    </label>

    <button class="btn-acao" @onclick="SalvarAsync" disabled="@ocupado">
        @(ocupado ? L["Btn_Salvando"] : L["Btn_Salvar"])
    </button>

    @if (Id.HasValue)
    {
        <button class="link" style="color:var(--hp-danger)" @onclick="ExcluirAsync">@L["App_ExcluirTarefa"]</button>
    }

    @if (erro is not null) { <p class="erro">@erro</p> }
}

@code {
    [Parameter] public int? Id { get; set; }

    private TarefaPersistenciaRequest _dto = new();
    private List<MembroSimplesDTO> _membros = new();
    private bool carregando = true;
    private bool ocupado;
    private string? erro;

    /// <summary>-1 = padrão da família (null na API).</summary>
    private const int PadraoFamilia = -1;
    private static readonly int[] OpcoesFixas = { PadraoFamilia, 15, 30, 60, 480, 1440 };
    private int _antecedencia = PadraoFamilia;

    private IEnumerable<int> OpcoesAntecedencia =>
        OpcoesFixas.Contains(_antecedencia) ? OpcoesFixas : OpcoesFixas.Append(_antecedencia).OrderBy(m => m);

    private string TextoAntecedencia(int min) => min switch
    {
        PadraoFamilia => L["Alerta_PadraoFamilia"],
        60 => L["Alerta_1Hora"],
        1440 => L["Alerta_1Dia"],
        _ when min >= 60 && min % 60 == 0 => string.Format(L["Alerta_HorasAntes"], min / 60),
        _ => string.Format(L["Alerta_MinutosAntes"], min),
    };

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        var (membros, _) = await Api.MembrosPlannerAsync();
        _membros = membros ?? new();

        if (Id.HasValue)
        {
            // Não há GET por id na API — carrega da listagem e localiza.
            var (lista, err) = await Api.ListarTarefasAsync(null);
            erro = err;
            var t = lista?.Itens.FirstOrDefault(x => x.Id == Id.Value);
            if (t is not null)
            {
                _dto = new TarefaPersistenciaRequest
                {
                    Id = t.Id, Titulo = t.Titulo, Descricao = t.Descricao,
                    DataPrevista = t.DataPrevista, HoraInicio = t.HoraInicio, HoraFim = t.HoraFim,
                    Recorrencia = t.Recorrencia, Visibilidade = t.Visibilidade,
                    ResponsavelUsuarioId = t.ResponsavelUsuarioId, NotificarResponsaveis = t.NotificarResponsaveis,
                    MinutosAntecedenciaLembrete = t.MinutosAntecedenciaLembrete,
                };
            }
            _antecedencia = _dto.MinutosAntecedenciaLembrete ?? PadraoFamilia;
        }
        else
        {
            _dto = new TarefaPersistenciaRequest { DataPrevista = DateOnly.FromDateTime(DateTime.Today) };
        }
        carregando = false;
    }

    private async Task SalvarAsync()
    {
        erro = null;
        if (string.IsNullOrWhiteSpace(_dto.Titulo)) { erro = L["App_InformeTitulo"]; return; }

        // "" no dropdown vira null (ninguém)
        if (string.IsNullOrEmpty(_dto.ResponsavelUsuarioId)) _dto.ResponsavelUsuarioId = null;
        _dto.MinutosAntecedenciaLembrete = _antecedencia == PadraoFamilia ? null : _antecedencia;

        ocupado = true;
        var (_, err) = await Api.SalvarTarefaAsync(_dto);
        ocupado = false;
        if (err is not null) { erro = err; return; }
        Nav.NavigateTo("/planner");
    }

    private async Task ExcluirAsync()
    {
        erro = await Api.DeletarTarefaAsync(Id!.Value);
        if (erro is null) Nav.NavigateTo("/planner");
    }
}
