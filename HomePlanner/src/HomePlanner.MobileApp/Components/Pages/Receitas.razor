@page "/receitas"
@using HomePlanner.MobileApp.Services
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<div class="barra-topo">
    <h2>@L["Nav_Receitas"]</h2>
    <button class="link" style="width:auto" @onclick='() => Nav.NavigateTo("/importar")'>⬇️ @L["Btn_Importar"]</button>
</div>

<input placeholder="@L["App_Buscar"]" @bind="busca" @bind:event="oninput" @onkeyup="AoTeclar" />

@if (carregando)
{
    <p class="muted">@L["Btn_Carregando"]</p>
}
else if (erro is not null)
{
    <p class="erro">@erro</p>
}
else if (lista is null || lista.Itens.Count == 0)
{
    <p class="muted">@L["Receita_Nenhuma"]</p>
}
else
{
    @foreach (var r in lista.Itens)
    {
        <div class="card-hp" @onclick="() => Abrir(r.Id)" style="cursor:pointer">
            <div class="linha">
                <h3>@r.Nome</h3>
                <span class="pill">@r.NumeroPorcoesBase @L["App_PorcoesAbrev"]</span>
            </div>
            <div class="muted">
                @(r.TempoPreparoMinutos.HasValue ? $"{r.TempoPreparoMinutos} min · " : "")
                @r.TotalIngredientes @L["App_IngredientesQtd"]
            </div>
        </div>
    }
}

@code {
    private ResultadoListagem<ReceitaListaDTO>? lista;
    private string busca = string.Empty;
    private bool carregando = true;
    private string? erro;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task AoTeclar(KeyboardEventArgs e) => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        carregando = true; erro = null;
        var (dados, err) = await Api.ListarReceitasAsync(busca, 1, _cts.Token);
        if (_cts.IsCancellationRequested) return;
        carregando = false;
        if (err is not null) { erro = err; return; }
        lista = dados;
    }

    private void Abrir(int id) => Nav.NavigateTo($"/receitas/{id}");
}

<button class="fab" @onclick='() => Nav.NavigateTo("/receitas/nova")'>+</button>
