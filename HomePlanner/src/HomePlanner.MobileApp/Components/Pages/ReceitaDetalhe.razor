@page "/receitas/{Id:int}"
@using HomePlanner.MobileApp.Services
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<button class="link" style="text-align:left;width:auto" @onclick='() => Nav.NavigateTo("/receitas")'>‹ @L["Btn_Voltar"]</button>

@if (carregando)
{
    <p class="muted">@L["Btn_Carregando"]</p>
}
else if (erro is not null)
{
    <p class="erro">@erro</p>
}
else if (r is not null)
{
    @if (_imgSrc is not null)
    {
        <img src="@_imgSrc" alt="@r.Nome" onerror="this.style.display='none'" style="width:100%;max-height:220px;object-fit:cover;border-radius:10px;margin-bottom:.6rem" />
    }
    <div class="barra-topo"><h2>@r.Nome</h2></div>
    <p class="muted">
        @r.NumeroPorcoesBase porções
        @(r.TempoPreparoMinutos.HasValue ? $" · {r.TempoPreparoMinutos} min" : "")
    </p>

    <div class="linha" style="gap:.4rem;margin-bottom:.4rem">
        <button class="link" style="width:auto" @onclick='() => Nav.NavigateTo($"/receitas/{r.Id}/editar")'>✏️ @L["Btn_Editar"]</button>
        <button class="link" style="width:auto" @onclick="DuplicarAsync">📄 @L["Btn_Duplicar"]</button>
        <button class="link" style="width:auto;color:var(--hp-danger)" @onclick="ExcluirAsync">🗑️ @L["Btn_Excluir"]</button>
    </div>
    @if (acaoErro is not null) { <p class="erro">@acaoErro</p> }

    @if (r.Componentes.Count > 0)
    {
        <div class="card-hp">
            <h3>@L["App_Componentes"]</h3>
            @foreach (var c in r.Componentes)
            {
                <div class="linha"><span>@c.Nome</span><span class="muted">@c.PorcoesDesejadas porç.</span></div>
            }
        </div>
    }

    <div class="card-hp">
        <h3>@L["Ing_Label"]</h3>
        @if (r.Ingredientes.Count == 0)
        {
            <p class="muted">@L["App_SemIngredientesCad"]</p>
        }
        else
        {
            @foreach (var i in r.Ingredientes)
            {
                <div class="linha">
                    <span>@i.NomeIngrediente @(i.Opcional ? "(opcional)" : "")</span>
                    <span class="muted">@FormatarQtd(i.Quantidade) @i.CodigoUnidade</span>
                </div>
            }
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(r.ModoPreparo))
    {
        <div class="card-hp">
            <h3>@L["Receita_ModoPreparoLabel"]</h3>
            <div style="white-space:pre-wrap">@r.ModoPreparo</div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private ReceitaDetalheDTO? r;
    private bool carregando = true;
    private string? erro;
    private string? acaoErro;
    private string? _imgSrc;

    protected override async Task OnParametersSetAsync()
    {
        carregando = true; erro = null; _imgSrc = null;
        var (dados, err) = await Api.ObterReceitaAsync(Id);
        carregando = false;
        if (err is not null) { erro = err; return; }
        r = dados;

        if (r is not null)
        {
            if (r.TemFoto)
                _imgSrc = await Api.ObterImagemDataUrlAsync($"/api/receitas/{r.Id}/foto");
            else if (r.UrlImagem is not null && r.UrlImagem.StartsWith("http"))
                _imgSrc = r.UrlImagem;
        }
    }

    private async Task DuplicarAsync()
    {
        acaoErro = null;
        var (novoId, err) = await Api.DuplicarReceitaAsync(Id);
        if (err is not null) { acaoErro = err; return; }
        Nav.NavigateTo($"/receitas/{novoId}");
    }

    private async Task ExcluirAsync()
    {
        acaoErro = await Api.DeletarReceitaAsync(Id);
        if (acaoErro is null) Nav.NavigateTo("/receitas");
    }

    private static string FormatarQtd(decimal q)
        => q == Math.Floor(q) ? ((int)q).ToString() : q.ToString("0.##");
}
