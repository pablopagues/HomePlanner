@page "/2fa"
@layout SemMenuLayout
@using HomePlanner.MobileApp.Services
@inject AuthApi Auth
@inject SessaoAtual Sessao
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<div class="auth">
    <h1>@L["Auth_2FATitulo"]</h1>
    <p class="sub">@(usarRecuperacao ? L["Auth_2FASubRec"] : L["Auth_2FASubApp"])</p>

    <label>@L["Auth_2FACodigo"]</label>
    <input @bind="codigo" inputmode="@(usarRecuperacao ? "text" : "numeric")" @onkeyup="AoTeclar" />

    <button class="primario" @onclick="ConfirmarAsync" disabled="@ocupado">
        @(ocupado ? L["Auth_2FAVerificando"] : L["Btn_Confirmar"])
    </button>

    <button class="link" @onclick="() => usarRecuperacao = !usarRecuperacao">
        @(usarRecuperacao ? L["Auth_2FAUsarApp"] : L["Auth_2FAUsarRec"])
    </button>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <p class="erro">@mensagem</p>
    }
</div>

@code {
    private string codigo = string.Empty;
    private bool usarRecuperacao;
    private bool ocupado;
    private string? mensagem;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Sessao.MfaTokenPendente))
            Nav.NavigateTo("/");
    }

    private async Task AoTeclar(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmarAsync();
    }

    private async Task ConfirmarAsync()
    {
        mensagem = null;
        if (string.IsNullOrWhiteSpace(codigo)) { mensagem = "Informe o código."; return; }

        ocupado = true;
        var erro = await Auth.Confirmar2FAAsync(Sessao.MfaTokenPendente!, codigo.Trim(), usarRecuperacao);
        ocupado = false;

        if (erro is not null) { mensagem = erro; return; }

        Sessao.MfaTokenPendente = null;
        // Mesmo desvio do login sem 2FA: família não configurada vai para o onboarding.
        Nav.NavigateTo(Sessao.OnboardingCompleto ? "/dashboard" : "/onboarding");
    }
}
